title: Reservoir (Trunk and Pump)
story: dungeo
description: Collect trunk and pump from drained reservoir. Restores from wt-04.
---

# Restore state from wt-04 (player at Living Room with torch and lantern)
# Reservoir already drained from wt-04 bolt turn
$restore wt-04

# ============================================================================
# GOAL: Navigate to Reservoir via Dam
# ============================================================================

[GOAL: Get trunk and pump from reservoir]

# Living Room -> Cellar -> Troll Room -> EW Passage -> Deep Ravine
# -> Chasm -> N/S Passage -> Loud Room -> Damp Cave -> Dam
# -> Deep Canyon -> Reservoir South -> Reservoir -> Reservoir North
> down

> east

> north

> north

> east

> east

> northeast

> up

> east

> south

> northwest

> north

# Trunk may have been stolen by the thief
> take trunk

> north

> take pump

[END GOAL]

# ============================================================================
# GOAL: Return to Living Room
# ============================================================================

[GOAL: Return to Living Room]

# Reservoir North -> Reservoir -> Reservoir South -> Deep Canyon
# -> Dam -> Damp Cave -> Loud Room -> N/S Passage -> Chasm
# -> Deep Ravine -> EW Passage -> Troll Room -> Cellar -> Living Room
> south

> south

> up

> east

> east

> south

> west

> north

> south

> south

> west

> west

> up

[END GOAL]

# ============================================================================
# GOAL: Verify final state
# ============================================================================

[GOAL: Verify inventory for next segment]

> drop trunk

> drop pump

> inventory

> look

[END GOAL]

# Save checkpoint for next walkthrough
$save wt-05

# SUCCESS! Reservoir items collected
