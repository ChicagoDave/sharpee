#!/usr/bin/env bash
# -------------------------------------------------------------------
# repokit — repo-local entry to the Sharpee in-repo platform build tool (ADR-187).
#
# A thin shim over the repokit engine (`tools/repokit/dist/cli.js`). repokit is
# the platform/maintenance counterpart to devkit (the author tool): it builds the
# platform packages, the CLI bundle, verify, test:npm, and the example stories.
# In-repo only; not published.
#
#   ./repokit build dungeo
#   ./repokit verify
#   ./repokit test:npm <location>
# -------------------------------------------------------------------
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CLI="$ROOT/tools/repokit/dist/cli.js"

if [ ! -f "$CLI" ]; then
  # Rebuild inline rather than telling the operator to do it. The obvious
  # instruction is also a trap: `pnpm --filter @sharpee/repokit build` runs
  # plain `tsc`, and if tsconfig.tsbuildinfo survived whatever removed dist/,
  # tsc decides it is up to date and emits NOTHING — so the fix appears to
  # succeed and `./repokit` still reports this same error. Dropping the
  # tsbuildinfo first is what actually restores the engine.
  #
  # Hit on plover 2026-08-13: website/deploy.sh calls `./repokit build
  # --playground`, tools/repokit/dist/ is gitignored so git pull never
  # supplies it, and `tsf build` deliberately skips repokit — so a host that
  # never built it by hand serves a 404 playground.
  echo "repokit: engine not built ($CLI missing) — building it now." >&2
  rm -f "$ROOT/tools/repokit/tsconfig.tsbuildinfo"
  ( cd "$ROOT" && pnpm --filter @sharpee/repokit build ) >&2 || {
    echo "repokit: could not build the engine." >&2
    exit 1
  }
  [ -f "$CLI" ] || { echo "repokit: build produced no $CLI." >&2; exit 1; }
fi

# Staleness gate (2026-07-27 incident): a repokit dist compiled before its
# source ran builds WITHOUT later fixes — e3ff8fb9's --external:esbuild never
# took effect and every bundle hung on cold hatch transpile. If any engine
# source is newer than the last engine build, rebuild inline (a no-op compile
# costs ~2s) and stamp the anchor — incremental tsc emits nothing on unchanged
# content, so the stamp (not dist mtimes) is what marks "built from this src".
BUILDINFO="$ROOT/tools/repokit/tsconfig.tsbuildinfo"
if [ ! -f "$BUILDINFO" ] || [ -n "$(find "$ROOT/tools/repokit/src" -name '*.ts' -newer "$BUILDINFO" -print -quit)" ]; then
  echo "repokit: engine source is newer than its last build — rebuilding the engine first." >&2
  (cd "$ROOT" && pnpm --filter @sharpee/repokit build >&2)
  touch "$BUILDINFO"
fi

exec node "$CLI" "$@"
