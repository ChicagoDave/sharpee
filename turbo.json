{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "1",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": false
    },
    "test:ci": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"],
      "env": [
        "CI",
        "UPDATE_GOLDEN",
        "DEVKIT_INTEGRATION",
        "SHARPEE_DEVKIT_REGISTRY",
        "SHARPEE_TRANSCRIPT_CORPUS",
        "WORLD_INDEX_SCALE_TABLE"
      ],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "typecheck:tests": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    }
  }
}