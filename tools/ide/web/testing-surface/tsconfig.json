{
  // Typecheck only — esbuild does the emitting (build.mjs). The one import
  // outside this directory is the synthesis module's channel-prose extractor
  // (ADR-306 D2: imported, never reimplemented); its `paths` entry must stay
  // in step with build.mjs's `alias` and vitest.config.ts — all three point
  // at the SOURCE file, so what is checked is what the bundle carries.
  // The two branch-tester entries used only by tests (the CLI's coverage
  // report formatters, for the golden test) point at the package's BUILT
  // declarations instead: the source would pull its whole runtime chain into
  // this program, where transcript-tester's src and dist types collide.
  // vitest still runs them from source.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@sharpee/branch-tester/auto-assertion": ["../../../../packages/branch-tester/src/auto-assertion.ts"],
      "@sharpee/branch-tester/types": ["../../../../packages/branch-tester/src/types.ts"],
      "@sharpee/branch-tester/tree-document": ["../../../../packages/branch-tester/src/tree-document.ts"],
      "@sharpee/transcript-tester/assertion-core": ["../../../../packages/transcript-tester/src/assertion-core.ts"],
      "@sharpee/story-loader/pin-grammar": ["../../../../packages/story-loader/src/pin-grammar.ts"],
      "@sharpee/ide-protocol/run-events": ["../../../../packages/ide-protocol/src/run-events.ts"],
      "@sharpee/branch-tester/coverage": ["../../../../packages/branch-tester/dist/coverage.d.ts"],
      "@sharpee/branch-tester/derived-runner": ["../../../../packages/branch-tester/dist/derived-runner.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
