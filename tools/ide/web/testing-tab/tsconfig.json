{
  // Typecheck only — esbuild does the emitting (build.mjs). The `paths` entry
  // must stay in step with build.mjs's `alias`: both point at the wire's SOURCE
  // so the tab is checked against the same file the bundle carries.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@sharpee/ide-protocol/run-events": ["../../../../packages/ide-protocol/src/run-events.ts"],
      "@sharpee/branch-tester/parser": ["../../../../packages/branch-tester/src/parser.ts"],
      "@sharpee/branch-tester/serializer": ["../../../../packages/branch-tester/src/serializer.ts"],
      "@sharpee/branch-tester/types": ["../../../../packages/branch-tester/src/types.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
