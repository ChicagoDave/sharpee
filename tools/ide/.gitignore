# XcodeGen output — regenerate via `xcodegen generate`
SharpeeIDE.xcodeproj/
SharpeeIDE/Info.plist

# Xcode build artifacts
# NB: macOS git is case-insensitive (core.ignorecase), so `build/` also matches the
# `SharpeeIDE/Build/` SOURCE group — re-include it explicitly so its .swift files track.
build/
!SharpeeIDE/Build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcworkspace/xcuserdata/

# Release artifacts from package.sh (ADR-279 D3). The DMG runs ~160MB thanks to
# the bundled Node runtime — far past GitHub's 100MB per-file limit — and is a
# build output, not a source. Distribution happens off a release page, not the repo.
release/

# Release artifacts from package-avalonia.sh — the Avalonia desktop head's
# slices. Same reasoning as release/ above: the portable zip alone is ~104MB,
# past GitHub's per-file limit, and it is a build output.
release-avalonia/

# Signing material must never be committed. package.sh reads the identity from
# the keychain and the notary credential from a notarytool profile, so nothing
# here should ever appear — this is the backstop for a stray manual copy.
*.p8
*.p12
*.cer
*.mobileprovision

# Swift Package Manager
.build/
.swiftpm/

# In-checkout compose scratches (TestingWorkspaceRealPathTests): copies of the
# frozen fixture placed inside the repo so the app's compose can resolve the
# toolchain by walking up. Removed by the test; this is the abort backstop.
test-fixtures/.compose-scratch-*/

# macOS
.DS_Store

# .NET build output from the Avalonia desktop head (PaneHost, PaneHost.Tests).
# `dotnet build`/`dotnet test` is a documented LOCAL gate, not CI — see
# PaneHost/README.md — so these are always developer-local.
PaneHost/bin/
PaneHost/obj/
PaneHost.Tests/bin/
PaneHost.Tests/obj/

# The editor's lexer bridge is bundled from packages/chord/src by its own
# build.mjs. Built, not authored.
editor-bridge/dist/
