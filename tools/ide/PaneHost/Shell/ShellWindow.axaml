<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:edit="using:AvaloniaEdit"
        xmlns:shell="using:PaneHost.Shell"
        x:Class="PaneHost.Shell.ShellWindow"
        Width="1400" Height="900"
        Title="Chord Writer (Avalonia)">
    <!--
      MainWindow.swift's shell: a 28 px chrome band, a 40 px rail, the project
      pane, the editor over its tab bar, a right panel with the real web panes,
      a bottom panel, and a 22 px status bar. Every custom surface below is a
      DrawnSurface — Render(DrawingContext), not a composed element tree.
    -->
    <Window.Resources>
        <x:Double x:Key="ChromeHeight">28</x:Double>
    </Window.Resources>

    <!--
      THE GRIP IS THE COLUMN. A GridSplitter is hit-testable only across its own bounds,
      so the 4 px track it used to sit in gave a 4 px target that was nearly uncatchable.
      The track is 10 px now.

      An earlier attempt kept the 4 px track and reached past it with a negative margin.
      Do not bring that back: a negative margin moves where the Grid arranges the splitter,
      so every drag started from an offset position and the pane jumped before it tracked
      the pointer. Widening the track costs 6 px of seam and nothing else.

      ResizeDirection is stated rather than inferred. Auto reads the splitter's own bounds
      to guess an axis, which is a guess that changes whenever the track's size changes.
    -->
    <Window.Styles>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        </Style>
        <Style Selector="GridSplitter.vertical">
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="Cursor" Value="SizeWestEast" />
        </Style>
        <Style Selector="GridSplitter.horizontal">
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="28,*,22">

        <!-- chrome band -->
        <Grid x:Name="Chrome" Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="10,0" Spacing="10">
                <Button x:Name="BuildButton" Content="Build" Padding="8,1" FontSize="11" />
                <Button x:Name="ComposeButton" Content="Compose" Padding="8,1" FontSize="11" />
            </StackPanel>
            <TextBlock x:Name="StoryTitle" Grid.Column="1" Text="—"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11.5" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0" Spacing="6">
                <Button x:Name="LightButton" Content="Light" Padding="8,1" FontSize="11" />
                <Button x:Name="DarkButton" Content="Dark" Padding="8,1" FontSize="11" />
            </StackPanel>
        </Grid>

        <!-- body -->
        <Grid x:Name="Body" Grid.Row="1" ColumnDefinitions="40,220,10,*,10,440">
            <StackPanel x:Name="Rail" Grid.Column="0" Orientation="Vertical" Spacing="8" Margin="0,8">
                <Button x:Name="ProjectToggle" Content="▤" FontSize="16" Width="40" Height="32" Background="Transparent" />
                <Button x:Name="BottomToggle" Content="⚒" FontSize="16" Width="40" Height="32" Background="Transparent" />
            </StackPanel>

            <shell:ProjectPaneView x:Name="ProjectPane" Grid.Column="1" />
            <GridSplitter x:Name="ProjectSplitter" Grid.Column="2" Classes="vertical" />

            <Grid x:Name="EditorColumn" Grid.Column="3" RowDefinitions="28,*,10,Auto">
                <shell:EditorTabBarView x:Name="EditorTabs" Grid.Row="0" />
                    <!-- Word wrap on by default: a story's prose lines run long, and the
                     alternative is horizontal scrolling to read a sentence. View ▸ Word Wrap
                     turns it off. -->
                <edit:TextEditor x:Name="Editor" Grid.Row="1" WordWrap="True"
                                 ShowLineNumbers="True" FontFamily="Menlo" FontSize="13" />
                <!-- Hidden with the panel it resizes: a live grip over a closed panel is
                     12 px of the editor's bottom edge that does not answer to clicks. -->
                <GridSplitter x:Name="BottomSplitter" Grid.Row="2" Classes="horizontal" IsVisible="False" />
                <Grid x:Name="BottomPanel" Grid.Row="3" Height="200" IsVisible="False"
                      RowDefinitions="30,*">
                    <shell:TabStripView x:Name="BottomTabs" Grid.Row="0" />
                    <TextBox x:Name="BottomText" Grid.Row="1" AcceptsReturn="True" IsReadOnly="True"
                             FontFamily="Menlo" FontSize="11" BorderThickness="0" />
                </Grid>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="4" Classes="vertical" />

            <Grid Grid.Column="5" RowDefinitions="30,*">
                <shell:TabStripView x:Name="RightTabs" Grid.Row="0" />
                <!--
                  ONE VIEW PER PANE, not one view re-navigated. Switching tabs used to
                  navigate a single web view, so coming back to Testing reloaded the page
                  and replayed the whole tree again — seconds of work to see something that
                  was already on screen a moment ago (GH #487). Each pane now keeps its own view and
                  its own state; switching tabs only changes which one is visible.
                -->
                <Panel Grid.Row="1">
                    <!-- The build log, which the shipping app shows in its own Build tab. -->
                    <TextBox x:Name="BuildLog" IsVisible="False" AcceptsReturn="True" IsReadOnly="True"
                             FontFamily="Menlo" FontSize="11" BorderThickness="0" />
                    <NativeWebView x:Name="PlayWeb" IsVisible="False" />
                    <NativeWebView x:Name="TestingWeb" IsVisible="False" />
                    <ScrollViewer x:Name="IndexScroll" IsVisible="False"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <shell:IndexPaneView x:Name="IndexPane" />
                    </ScrollViewer>
                    <NativeWebView x:Name="DocsWeb" IsVisible="False" />
                    <!--
                      The World tab's three sub-panes, as the shipping app segments them
                      (SharpeeIDE/World/WorldView.swift): Map, Reach, Incomplete. Incomplete
                      is a placeholder here until Phase 15 builds its fix workflow — shown
                      as a tab that says so rather than omitted, so the shape of the pane
                      matches what an author sees in the other head.
                    -->
                    <Grid x:Name="WorldPane" IsVisible="False" RowDefinitions="30,*">
                        <shell:TabStripView x:Name="WorldTabs" Grid.Row="0" />
                        <Panel Grid.Row="1">
                            <ScrollViewer x:Name="WorldScroll"
                                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <shell:WorldMapView x:Name="WorldMap" />
                            </ScrollViewer>
                            <ScrollViewer x:Name="WorldReachScroll" IsVisible="False"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <shell:WorldReachView x:Name="WorldReach" />
                            </ScrollViewer>
                            <TextBlock x:Name="WorldIncomplete" IsVisible="False" Margin="10" FontSize="11.5"
                                       TextWrapping="Wrap"
                                       Text="The Incomplete view is not built in this head yet — the analysis is there, the fix workflow is not." />
                        </Panel>
                    </Grid>
                </Panel>
            </Grid>
        </Grid>

        <!-- status bar -->
        <Grid x:Name="StatusBar" Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
            <TextBlock x:Name="BuildPill" Grid.Column="0" Margin="10,0" VerticalAlignment="Center" FontSize="10.5" Text="idle" />
            <TextBlock x:Name="StatusText" Grid.Column="2" Margin="10,0" VerticalAlignment="Center" FontSize="10.5" Text="" />
        </Grid>
    </Grid>
</Window>
