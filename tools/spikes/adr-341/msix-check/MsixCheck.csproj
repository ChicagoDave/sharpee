<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Adr341MsixCheck</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The vendored toolchain rides in the package payload, which is the whole
         point of check (a): MSIX installs to C:\Program Files\WindowsApps, and
         executing a bundled binary from there is the thing to verify. -->
    <Content Include="vendor\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
