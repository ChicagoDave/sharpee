<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged. The spike is evidence, not a shippable app; MSIX is Phase 5's
         own question and dragging it in here would conflate two checks. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Adr341WinUi3Spike</AssemblyName>
    <RootNamespace>Adr341.WinUi3Spike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <!-- Microsoft.Windows.SDK.BuildTools comes in transitively at the version the App
         SDK requires (10.0.26100.4654). Pinning it explicitly only produces an NU1605
         downgrade error. Noted for Phase 5: this is also the answer to Phase 0's
         "no Windows SDK installed" gap — the packaging tools arrive by NuGet. -->
    <!-- The decisive dependency: WinUI 3's only genuinely native code editor, and a
         self-declared "early work-in-progress ... not production ready". -->
    <PackageReference Include="WinUIEdit" Version="0.0.5-prerelease" />
    <PackageReference Include="TreeSitter.DotNet" Version="1.3.0" />
  </ItemGroup>

</Project>
