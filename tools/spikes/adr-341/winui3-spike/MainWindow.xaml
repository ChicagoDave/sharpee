<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Adr341.WinUi3Spike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:editor="using:WinUIEditor"
    xmlns:local="using:Adr341.WinUi3Spike"
    Title="ADR-341 — WinUI 3 spike">

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Title band + the same reparse readout the WPF spike carries, so the
         measurement is comparable rather than re-derived. -->
    <Grid Grid.Row="0" Height="38" Padding="12,0">
      <TextBlock Text="The Secret Letter" HorizontalAlignment="Center"
                 VerticalAlignment="Center" FontWeight="SemiBold"/>
      <TextBlock x:Name="Perf" HorizontalAlignment="Right" VerticalAlignment="Center"
                 FontFamily="Consolas" FontSize="11" Opacity="0.7"/>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>

      <!-- SPIKE ITEM 1 (decisive): WinUIEdit, the Scintilla port. -->
      <editor:CodeEditorControl x:Name="Editor" Grid.Column="0"/>

      <!-- SPIKE ITEM 2: custom drawing. WPF had OnRender/DrawingContext; WinUI 3
           has no retained-mode drawing surface, so this is the comparison. -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <local:TabStrip x:Name="Tabs" Grid.Row="0" Height="32"/>
        <local:WorldMap x:Name="Map" Grid.Row="1"/>
      </Grid>
    </Grid>

    <Border Grid.Row="2" Height="26" Padding="10,0">
      <TextBlock x:Name="Status" VerticalAlignment="Center" FontSize="11"/>
    </Border>
  </Grid>
</Window>
