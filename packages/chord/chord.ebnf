(* ==========================================================================
   Chord Grammar — EBNF
   ==========================================================================
   Machine-oriented extraction of the Chord grammar as the parser implements
   it (packages/chord/src/parser.ts). This file is the language's surface of
   record: tests/language-version.test.ts pins its hash to
   CHORD_LANGUAGE_VERSION (ADR-257 D5), and the website's grammar reference
   (website/src/app/chord/reference/grammar/content.mdx) serves it for
   download. Grammar changes require David's approval and a row in
   docs/architecture/chord-grammar-changes.md; the analyzer gates named in
   the comments below are the diagnostic codes in src/analyzer.ts.

   Coverage: Phase A subset + Phase B declarations + Phase C ownership
   package + the each package (E1–E3) + ADR-211/zoo-surfaces (Z1/Z4/Z5,
   CP1'/CP3/Z3b/Z6) + ADR-231 D5a (`starts <state>` initializers) +
   ADR-261 (`use scoring` with its rank ladder), as of 2026-07-24; brought
   to parity with the parser's dispatch tables on 2026-08-29 (ADR-310 the
   character model, ADR-318 the normative layer, ADR-325 timers/places/
   landings, ADR-227 `kill`, ADR-230 `carries`). Removed forms the parser
   still names with a fix-it (`define verb|flag|score|behavior`, `if`) are
   not productions here.

   Notation:
     UPPER      = token class          "quoted" = literal word
     [ x ]      = optional             { x }    = zero or more
     x | y      = alternatives         ( * … * ) = comment (written without the spaces)
     NL         = end of source line (Chord is line-oriented)
     >>>        = an indented block follows (layout; EBNF cannot express
                  indentation — the summary below is the rule)

   Layout summary:
     - Indentation is spaces only; a tab is a lex error.
     - Blocks open with their header line and close at dedent or their
       explicit "end <kw>" terminator per the Layout table.
     - A blank line inside a prose block is a paragraph break; in create
       blocks a blank line ends the block, but later bare paragraphs
       append to the description.
   ========================================================================== *)


(* ---- Tokens ------------------------------------------------------------ *)

WORD    = letter { letter | digit | "'" | "-" | "_" } ;   (* cant-leave, you'd *)
NUMBER  = digit { digit } { "." digit { digit } } ;        (* 1, 20, 1.0.0 *)
STRING  = '"' any-except-'"' '"' ;                         (* no escapes *)
MARKER  = "{" content "}" ;                                (* inside prose text only *)
LOCALE  = WORD ;                                           (* e.g. en-US *)

rest-of-line    = any-except-NL ;                          (* trimmed at both ends *)
prose-line      = rest-of-line NL ;                        (* MARKERs extracted inline *)
prose-paragraph = prose-line { prose-line } ;              (* an indented run of text
                                                              lines joined by single
                                                              spaces; stops at dedent
                                                              or an `end` line. Where
                                                              the host allows several
                                                              paragraphs (phrase and
                                                              variant bodies, kill and
                                                              timer bodies) a blank
                                                              line starts a new one;
                                                              elsewhere (a create
                                                              description) it ends
                                                              the block *)
inline-prose    = >>> prose-paragraph ;                    (* a body under a statement *)


(* ---- Comments (ADR-249) ------------------------------------------------ *)

comment-line = "##" rest-of-line NL ;          (* column 1 — indent 0 only *)
comment-run  = comment-line { comment-line } ; (* blank-delimited on both sides;
                                                  file start/end count as blank.
                                                  Legal only between top-level
                                                  constructs; contributes nothing.
                                                  No end-of-line comment form
                                                  exists. Inside a construct:
                                                  parse.comment-inside-block;
                                                  undelimited:
                                                  lex.comment-blank-lines. *)

(* ---- Top level --------------------------------------------------------- *)

story-file   = [ comment-run ] [ story-header ] { declaration | comment-run } ;

grammar-file   = [ comment-run ] grammar-header
                 { define-action | "import" STRING NL | comment-run } ;
                                                  (* ADR-269 D8: a grammar file carries
                                                     define-action GRAMMAR surfaces only —
                                                     behavior lines (must / refuse /
                                                     otherwise / score / phrases / body)
                                                     and every other declaration kind are
                                                     analyzer errors
                                                     (analysis.grammar-file-behavior /
                                                     analysis.grammar-file-declaration).
                                                     D10: `define action <name>` binds the
                                                     platform action id derived from
                                                     <name>, validated by the consuming
                                                     build step — never minted as
                                                     chord.action.*. The two headers are
                                                     mutually exclusive
                                                     (parse.mixed-headers). *)
grammar-header = "grammar" STRING NL ;            (* no `by`, no indented body
                                                     (parse.grammar-header-body) *)

claims-file  = [ comment-run ] claims-block { comment-run } ;
                                                  (* ADR-365 D7: the claims fragment — a
                                                     `.chord` file the test tree's
                                                     manifest names (`"claims": "<path>"`,
                                                     relative to the story file) and the
                                                     story never imports. Compiled only by
                                                     compileClaims(story, fragment): one
                                                     block and nothing else
                                                     (claims.fragment-content /
                                                     claims.fragment-empty /
                                                     claims.fragment-duplicate; a story
                                                     header is claims.fragment-story).
                                                     The parser reads a `claims` block
                                                     wherever it stands; one met in a
                                                     story or an imported fragment is
                                                     analysis.claims-in-story, so a claim
                                                     never reaches the published IR.
                                                     Distinct from the `, claims <fact> is
                                                     <value>` phrase tag (ADR-318 D9). *)
claims-block = "claims" NL                        (* parse.claims-head: nothing after it *)
                 >>> { needs-line } claim-decl { claim-decl }
               "end" "claims" NL ;                (* parse.claims-empty: no claim;
                                                     parse.claims-line: a line the block
                                                     does not know *)
needs-line   = "needs" ( "rooms" | "things" ) ":" name { "," [ "and" ] name } NL
             | "needs" "verbs" ":" verb-phrase { "," verb-phrase } NL ;
                                                  (* ADR-365 D2: one key of the necessary
                                                     set. At block level the shared set;
                                                     under a claim, its own — a key named
                                                     replaces the shared key, the rest is
                                                     inherited, and claims with the same
                                                     effective set share one walk. Rooms
                                                     must be rooms (claims.needs-room-
                                                     kind), things must not be
                                                     (claims.needs-thing-kind), the player
                                                     is never listed (claims.needs-player).
                                                     Empty or ill-formed: parse.claim-needs *)
verb-phrase  = WORD { WORD } ;                     (* a command prefix the walk may type:
                                                     `turn on` *)
claim-decl   = ( "claim" | "never" ) rest-of-line NL
                                                  (* the name is the sentence the report
                                                     prints (parse.claim-name when absent);
                                                     `never` heads the negative claim —
                                                     violated by its first witness, held
                                                     only when the walk exhausts its set
                                                     (ADR-365 D3) *)
                 >>> claim-predicate { needs-line } ;
                                                  (* exactly one predicate line:
                                                     parse.claim-no-predicate /
                                                     parse.claim-two-predicates *)
claim-predicate = "the" "story" "ends" "in" WORD NL  (* `victory` | `defeat`
                                                     (claims.ending-kind); parse.claim-
                                                     ending when `in <kind>` is missing *)
                | "the" "story" "has" "ended" NL   (* any ending *)
                | name "was" "asked" "about" STRING NL
                                                  (* a person was asked the quoted topic
                                                     (if.event.asked); parse.claim-asked *)
                | name "has" "been" WORD NL        (* an `on` clause of the thing has
                                                     fired: the participle is matched to
                                                     the thing's clause gerunds
                                                     (claims.action-unknown names what it
                                                     answers to; claims.action-owner for
                                                     the player) *)
                | condition NL ;                   (* a Chord condition, one of:
                                                     `<thing> is <state>` — a declared
                                                     state first, else a platform flag
                                                     word (open/closed, locked/unlocked,
                                                     on/off, lit/unlit, worn/unworn,
                                                     read/unread; claims.state-unknown
                                                     otherwise); `<thing> is in <place>`;
                                                     `<thing> is not in <room>`
                                                     (claims.room-expected); `the player
                                                     is in <room>`; `the player has
                                                     <thing>`; `the story is <state>`.
                                                     `is not <state>` is claims.predicate-
                                                     negated (head the claim `never`);
                                                     anything else is claims.predicate-
                                                     unsupported. parse.claim-predicate:
                                                     words after the condition *)

story-header = "story" NL                         (* ADR-298: positional
                                                     `story STRING ["by" STRING]`
                                                     removed
                                                     (parse.removed-story-header) *)
               >>> { states-line | score-line | story-on-clause | use-line
                   | use-phrasebook-line
                   | timer-clause                     (* ADR-325 D3e: a story-owned
                                                         timer's expiry (a `define
                                                         timer` with no `for`) *)
                   | meta-field } ;
meta-field   = "title" ":" rest-of-line NL        (* required (parse.story-title) *)
             | "id" ":" rest-of-line NL
             | "story-version" ":" rest-of-line NL
             | "ifid" ":" rest-of-line NL         (* absent → analysis.missing-ifid
                                                     warning; publish hard-errors
                                                     (ADR-284) *)
             | name-list-field | prose-field
             | client-config-field ;
client-config-field                               (* ADR-252 D3 browser-build keys,
                                                     folded into the closed set by
                                                     the ADR-298 amendment
                                                     (GH #221, 2026-08-03) *)
             = ( "client" | "theme" | "template"
               | "default-theme" | "storage-prefix" ) ":" rest-of-line NL
             | "themes" ":" rest-of-line NL ;     (* comma list of theme names *)
                                                  (* Closed schema (ADR-298 D4):
                                                     any other key is
                                                     parse.header-unknown-field;
                                                     `version:` / `blurb:` / `by:`
                                                     are removed spellings with
                                                     fix-its (story-version /
                                                     description / authors). *)
name-list-field = ( "authors" | "testers" ) ":" [ rest-of-line ] NL
                  { >>> rest-of-line NL } ;       (* one name per indented line,
                                                     or a single inline name;
                                                     empty list is
                                                     parse.header-list-empty *)
prose-field  = ( "prologue" | "description" ) ":" [ rest-of-line ] NL
               { >>> rest-of-line NL } ;          (* value is literal prose UNLESS
                                                     it is exactly one kebab atom —
                                                     then it is a phrase reference
                                                     (analysis.missing-phrase if
                                                     undeclared). Never
                                                     resolve-if-exists. *)
use-line     = use-scoring-line | use-hunger-line | use-plain-line ;
use-plain-line = "use" WORD [ announce-suffix ] NL ;       (* ADR-215: one trusted
                                                              platform extension per
                                                              line (combat, chapters
                                                              — ADR-330; expanses —
                                                              ADR-376, which may
                                                              contribute a kind noun and
                                                              a movement type under
                                                              ADR-366 D12; sailing —
                                                              ADR-375, which requires
                                                              `use expanses`: analysis.
                                                              sailing-needs-expanses);
                                                              admits
                                                              the extension's manifest
                                                              vocabulary and triggers
                                                              its runtime registration.
                                                              Unknown/duplicate names
                                                              and `use` of CORE
                                                              vocabulary (npc, and
                                                              state-machines under
                                                              ADR-377) are
                                                              compile errors; top-level
                                                              placement gets a header
                                                              fix-it. Takes NO body —
                                                              an indented block under
                                                              any name but `scoring`
                                                              is parse.use-body *)
use-scoring-line = "use" "scoring" [ announce-suffix ] NL
               >>> { rank-line } ;                         (* ADR-261 D2: the only
                                                              `use` line with a body —
                                                              the rank ladder rides the
                                                              line that enables it, so
                                                              a ladder can never be
                                                              silently disabled *)
announce-suffix = "," "announce"
                  ( "all" | "collapsed" | "combined" | "silent" ) ;
                                                           (* ADR-262 D3: how a
                                                              metering extension's band
                                                              crossings narrate. `all`
                                                              (default) reports each
                                                              elevation; `silent` is
                                                              the only route to no
                                                              output *)
use-hunger-line = "use" "hunger" [ announce-suffix ] NL
               >>> { hunger-grows-line
                   | meter-rung-line
                   | hunger-fatal-line } ;                (* ADR-263 D1: a depleting
                                                              satiety meter over the
                                                              ADR-262 engine *)
hunger-grows-line = "grows" NUMBER "each" "turn" NL ;     (* per-turn severity gain,
                                                              lowered to `on every turn` *)
meter-rung-line = WORD "at" NUMBER [ "says" WORD ] NL ;   (* a band: bareword name
                                                              (its id), absolute
                                                              threshold, optional
                                                              story phrase *)
hunger-fatal-line = "fatal" "at" NUMBER NL ;              (* a raw-value death trigger
                                                              above the top band,
                                                              lowered to `kill the
                                                              player` *)
rank-line    = "rank" STRING "at" NUMBER [ "says" WORD ] NL ;
                                                           (* ADR-261 D2/D7: a rung.
                                                              STRING is author prose,
                                                              never a phrasebook key
                                                              (ADR-260 D4). NUMBER is
                                                              ABSOLUTE points, never a
                                                              percentage of max — so a
                                                              maxScore change cannot
                                                              move a boundary. `says`
                                                              names a key in the story's
                                                              own phrase namespace,
                                                              spoken once on crossing;
                                                              a rung without it is
                                                              silent, there being no
                                                              platform sentence to fall
                                                              back to. Rungs sort at
                                                              compile time; a rung
                                                              outside this body is
                                                              parse.rank-outside-scoring *)
story-on-clause = on-clause ;                              (* ADR-236 D7 (ratchet R4):
                                                              `on every turn` ONLY —
                                                              any other clause form is
                                                              parse.story-clause. Story-
                                                              owned daemon: no presence
                                                              gate, narration broadcasts,
                                                              `it` unbound (compile error
                                                              analysis.story-clause-it) *)
declaration  = create | start-block | define-condition | define-phrase | define-phrases
                                                           (* define-verb REMOVED — ADR-270 D7;
                                                              define-text and define-hatch
                                                              REMOVED — ADR-361 D1 *)
             | define-trait | define-action
             | define-sequence
             | define-counter                              (* ADR-264 *)
             | define-timer                                (* ADR-325 D3a *)
             | define-chapters                             (* ADR-330, `use chapters` *)
             | define-machine                              (* ADR-215, use-gated *)
             | define-fact | define-profile                (* ADR-310 D14 / D4 *)
             | define-mood | define-personality            (* ADR-310 D5 *)
             | define-temperament | define-code            (* ADR-318 D3 / D4 *)
             | define-honor | define-topic                 (* ADR-318 D7 / D12a *)
             | define-asset | define-channel               (* ADR-216 *)
             | define-family-channel                       (* ADR-241 *)
             | define-topics                               (* ADR-239 *)
             | define-manner | define-greetings            (* ADR-320, frozen 2026-08-17 *)
             | define-exchange | define-initiative         (* ADR-320, frozen 2026-08-17 *)
             | define-conversation                         (* ADR-320 D14, frozen 2026-08-17 *)
             | define-pronouns                             (* ADR-242 *)
             | define-phrasebook | import-phrasebook       (* ADR-245/250 *)
             | override-message | override-messages       (* ADR-255 *)
             | extend-action | remove-from-action ;       (* ADR-270 *)

(* ---- Message overrides (ADR-255, 2026-07-22) --------------------------- *)

override-message    = "override" "message" ALIAS
                      [ "," ( STRATEGY | "verbatim" ) ] NL
                      >>> prose { "or" NL >>> prose }
                      "end" "override" NL ;                (* the full define-phrase body;
                                                              an alias absent from the ACL
                                                              catalog is
                                                              analysis.unknown-message-alias *)
override-messages   = "override" "messages" LOCALE NL
                      >>> { ALIAS ":" NL >>> prose } ;     (* localizable flat block *)
ALIAS               = WORD ;                               (* an ACL alias, <action>-<message>,
                                                             single kebab word (ADR-254/255) *)

(* ---- Phrasebooks (ADR-245/250, 2026-07-21) ----------------------------- *)

define-phrasebook   = "define" "phrasebook" WORD [ "while" condition ] NL
                      >>> { phrasebook-entry }
                      "end" "phrasebook" NL ;              (* entry-level `while` is
                                                              analysis.phrasebook-entry-gate;
                                                              keys are STORY keys only —
                                                              dotted platform IDs are
                                                              analysis.phrasebook-dotted-key.
                                                              Predicate-less = the DEFAULT
                                                              (always) book. Arbitration:
                                                              first predicate-match in
                                                              file-appearance order, per
                                                              key; story define phrase /
                                                              per-entity phrase always win. *)
phrasebook-entry    = WORD [ "," STRATEGY | "," "verbatim" ] ":" NL
                      >>> prose { "or" NL >>> prose } ;    (* the phrase-override entry
                                                              grammar, book-scoped *)
use-phrasebook-line = "use" "phrasebook" WORD [ "while" condition ] NL ;
                                                           (* header body; stackable; the
                                                              `phrasebook` sub-word selects
                                                              the two-word form — plain
                                                              one-word `use` untouched.
                                                              Unknown name:
                                                              analysis.unknown-phrasebook *)
import-phrasebook   = "import" "phrasebook" STRING NL ;    (* top level; STRING ends
                                                              ".story"; fragment holds only
                                                              define-phrasebook blocks +
                                                              ## comments; splices at the
                                                              import site (= arbitration
                                                              position). Bare import is
                                                              reserved (parked ADR). *)

(* `define behavior … from` was REMOVED (ADR-235 D2, 2026-07-18) — a parse
   error with a fix-it naming `define trait` + clauses. *)

(* The hatches were REMOVED (ADR-361 D1, 2026-10-09) — Chord's syntax is
   closed. Each form is a parse error with a fix-it, so none has a
   production: `define text … from` (parse.removed-text-hatch: write a
   `define phrase` with a strategy), `define action … from`
   (parse.removed-action-hatch: write a `define action` block), and
   `define chain … from` (parse.removed-chain-hatch: no Chord form yet).
   The `define action <name>` block and `define sound|image|music … from`
   are unaffected. *)

(* Removed from the top level (ownership ratchet 2026-07-11) — parse errors
   with owner-attached fix-its, so they have no productions: `when` rules,
   `once <condition>` rules, `every N turns` rules, `define flag`,
   `define score`, and `if`/`else`/`end if` anywhere. *)


(* ---- Ownership lines (D2/D4/D8/D12) ------------------------------------ *)

states-line  = "states" [ "," "reversible" ] ":" WORD { "," WORD } NL ;
               (* legal in story header, create blocks, define trait blocks *)
score-line   = "score" WORD "worth" NUMBER NL ;
               (* legal in story header, create, define trait, define action *)
holds-line   = "holds" NUMBER NL ;                         (* ADR-369 D2: the item
                                                              capacity of a container
                                                              or supporter (analysis.
                                                              holds-owner elsewhere);
                                                              NUMBER >= 1 (parse.holds-
                                                              number); at most one
                                                              (analysis.holds-duplicate) *)
vehicle-line = "movement" ":" ( "none" | "line" | "streets"
                              | "compass" | "flight"
                              | "open" ) NL               (* ADR-366 D5: every vehicle
                                                              names its movement type
                                                              (analysis.vehicle-missing-
                                                              movement). `open` is
                                                              `use expanses` vocabulary
                                                              (ADR-376 D3; analysis.
                                                              expanses-needs-use). The lines
                                                              below are legal only in a
                                                              `vehicle` block and only
                                                              under the types D5's
                                                              table gives each
                                                              (analysis.vehicle-line-
                                                              not-for-movement) *)
             | "carries" ":" ( "in" | "on" ) NL            (* D2: in or on the vehicle;
                                                              required without rooms
                                                              aboard, forbidden with
                                                              them. The colon tells it
                                                              from `carries <name>` *)
             | "drive" ":" ( "state" | "control" | "player" ) NL
                                                           (* D5: required on every
                                                              type but `none` *)
             | "commands" ":" WORD { "," WORD } NL         (* D5i: the player's command
                                                              sets; `naval` is ADR-375
                                                              D3's, on an open vehicle
                                                              under `use sailing`
                                                              (analysis.sailing-needs-
                                                              use, sailing-not-open).
                                                              D5i: the player's command
                                                              sets (`compass`,
                                                              `destinations`); `drive:
                                                              player` only *)
             | "stops" ":" name { "," name } NL            (* D5a: a line's stops in
                                                              order, two or more, none
                                                              repeated *)
             | "direction" ":" ( "both" | "one-way" ) NL  (* D5a *)
             | "pace" ":" NUMBER ( "turn" | "turns" ) NL  (* D5a, D5c: turns per step,
                                                              one or more *)
             | "destinations" ":" name { "," name } NL    (* D5d: any to any, two or
                                                              more *)
             | "passage" ":" NUMBER ( "turn" | "turns" ) NL
                                                           (* D5d: the fold, one or
                                                              more turns *)
             | "aboard" ":" name { "," name } NL           (* D7: the rooms inside *)
             | "boarded" "through" ":" name NL            (* D7: one of them, where
                                                              `to outside` lands *)
             | "stride" ":" NUMBER ( "unit" | "units" ) NL
                                                           (* ADR-376 D3: an open
                                                              vehicle's units per step,
                                                              one or more, required
                                                              (analysis.open-missing-
                                                              stride) *)
             | sight-line                                  (* ADR-376 D6: required on an
                                                              open vehicle (analysis.
                                                              open-missing-sight) *)
             | seen-from-afar-line                         (* ADR-376 D6: required on an
                                                              open vehicle (analysis.
                                                              missing-seen-from-afar) *)
             | "sails" ":" WORD { "," WORD } NL            (* ADR-375 D7, under `use
                                                              sailing`, on an open vehicle
                                                              with a sailing block: the
                                                              settings, least to most
                                                              canvas (analysis.sails-
                                                              without-sailing, sails-
                                                              unknown-setting) *)
             | "sails" "start" ":" WORD NL                 (* ADR-375 D7: the starting
                                                              setting, required with
                                                              `sails:` (analysis.sails-
                                                              missing-start) *)
             | sailing-block ;                             (* ADR-375 D5, below *)
sailing-block = "sailing" NL
              >>> { NUMBER "to" NUMBER "degrees" ":" sailing-cells NL
                  | "calm" ":" sailing-pace NL }
                "end" "sailing" NL ;                       (* ADR-375 D5, D7, under `use
                                                              sailing`: the pace by the
                                                              angle off the wind, 0 dead
                                                              into it, 180 dead before;
                                                              the bands cover 0 to 180
                                                              once (analysis.sailing-gap,
                                                              -overlap); one `calm:` row
                                                              (analysis.sailing-no-calm);
                                                              in place of `pace:`
                                                              (analysis.sailing-and-pace);
                                                              the expanse carries a wind
                                                              (analysis.sailing-without-
                                                              wind); off an open vehicle
                                                              analysis.sailing-not-open;
                                                              a row of another shape
                                                              parse.sailing-row *)
sailing-cells = sailing-pace                               (* without `sails:` *)
              | WORD sailing-pace { "," WORD sailing-pace } ;
                                                           (* with `sails:`, every
                                                              setting once (analysis.
                                                              sailing-row-missing-
                                                              setting) *)
sailing-pace = NUMBER ( "turn" | "turns" ) | "stopped" ;
sight-line   = "sight" ":" NUMBER NL ;                     (* ADR-376 D6: expanse units.
                                                              On an open vehicle, how far
                                                              one sees from it; on a
                                                              landmark room, its outlook
                                                              over the expanse; on a
                                                              thing, an instrument
                                                              (`look through`). Elsewhere
                                                              analysis.sight-owner *)
seen-from-afar-line = "seen" "from" "afar" ":" rest-of-line NL ;
                                                           (* ADR-376 D6: the distant
                                                              prose of an open vehicle or
                                                              a landmark room, required
                                                              on both (analysis.missing-
                                                              seen-from-afar); elsewhere
                                                              analysis.seen-from-afar-
                                                              owner *)
expanse-line = "size" ":" NUMBER "by" NUMBER NL            (* ADR-376 D2: the two axes,
                                                              each one or more, required
                                                              (analysis.expanse-missing-
                                                              size); coordinates run
                                                              0..w-1 east, 0..h-1 north *)
             | "visibility" ":" NUMBER NL                  (* ADR-376 D6: a cap on every
                                                              looker's sight *)
             | "wind" ":" ( "from" ( DIRECTION | NUMBER "degrees" )
                          | "calm" ) NL                    (* ADR-375 D4, under `use
                                                              sailing`: the wind an
                                                              expanse carries, from a
                                                              compass direction or a
                                                              bearing 0..359; on anything
                                                              but an expanse analysis.
                                                              sailing-not-open *)
             | "drift" ":" "1" "unit" "every" NUMBER ( "turn" | "turns" ) NL ;
                                                           (* ADR-376 D10: floating things
                                                              move one unit per interval;
                                                              required once anything
                                                              floats in the expanse
                                                              (analysis.floats-without-
                                                              drift). Each line is an
                                                              expanse's alone (analysis.
                                                              expanse-line-owner) *)
landmarks-block = "landmarks" NL
                >>> { name ":" NUMBER "," NUMBER NL }
                  "end" "landmarks" NL ;                   (* ADR-376 D2: the rooms an
                                                              expanse holds at its
                                                              coordinates (parse.landmark-
                                                              row; analysis.landmark-not-
                                                              room, -outside-expanse,
                                                              -duplicate); on anything
                                                              but an expanse analysis.
                                                              landmarks-owner. An
                                                              expanse's blocked-exit
                                                              lines are its edges, the
                                                              four sides only and never
                                                              `while` (analysis.expanse-
                                                              exit, analysis.edge-while);
                                                              it has no exits (D8) *)
admits-line  = "admits" ":" admits-list NL ;               (* ADR-366 D6: on a room, a
                                                              `rooms` group or a region
                                                              — the steered vehicles
                                                              (`streets`, `compass`)
                                                              that may enter it
                                                              (analysis.admits-not-
                                                              steered-vehicle); a block
                                                              that is none of those is
                                                              analysis.admits-owner *)
admits-list  = admits-word { "," admits-word } ;
admits-word  = name | "pushing" ;                          (* ADR-378 D6: a steered
                                                              vehicle, or the class word
                                                              for a thing pushed along
                                                              the way; any other word is
                                                              analysis.admits-not-
                                                              steered-vehicle *)
pushing-block = "pushing" NL
               >>> { ( "between" name "and" name | "from" name "to" name ) NL }
                 "end" "pushing" NL ;                      (* ADR-378 D6b: on a pushable
                                                              thing, the ways it may be
                                                              pushed along as room pairs
                                                              — `between` both ways,
                                                              `from … to` one way. A row
                                                              naming no compass exit the
                                                              first room has to the second
                                                              is analysis.pushing-no-exit;
                                                              on a thing that is not
                                                              pushable, analysis.pushing-
                                                              not-pushable; a second block
                                                              is parse.pushing-duplicate;
                                                              any other row shape is
                                                              parse.pushing-row *)
position-block = "position" NL
               >>> { "when" condition ":" name NL }
                   "otherwise" ":" name NL
                 "end" "position" NL ;                     (* ADR-366 D5a: a `drive:
                                                              state` line's place, read
                                                              top to bottom after each
                                                              turn; every row names a
                                                              stop (analysis.not-a-stop);
                                                              the last row is `otherwise`
                                                              (analysis.position-no-
                                                              otherwise); on a one-way
                                                              line no row names a stop
                                                              behind an earlier row's
                                                              (analysis.position-against-
                                                              direction) *)
counter-line = "counter" WORD [ "starts" NUMBER ]
                         [ "between" NUMBER "and" NUMBER ] NL ;
               (* ADR-264 D1: a per-entity numeric counter, legal in a create
                  block; story-global counters use `define counter` instead *)


(* ---- on / after clauses (D3/D5; heads ADR-327 D1) ---------------------- *)

on-clause    = ( "on" | "after" ) clause-form
               [ "while" condition | "during" WORD ]     (* ADR-330 D5: `during
                                                              <chapter>` on a head is
                                                              sugar for `while during
                                                              <chapter>`; both on one
                                                              head is parse.head-while-
                                                              during. The same sugar
                                                              stands wherever a line
                                                              takes `while condition`:
                                                              blocked/deadly exits,
                                                              phrase overrides and
                                                              gates, phrasebooks, timer
                                                              and move clauses, and a
                                                              composition's `while` *)
               { "," clause-modifier } NL
               >>> { statement } "end" ( "on" | "after" ) NL ;
                                        (* terminator matches the opener *)
clause-form  = head [ counterpart ]                  (* ADR-372 D1: the other
                                                        noun of a two-noun action
                                                        — the clause fires only
                                                        when the command's other
                                                        noun is this thing *)
               [ "to" WORD                            (* ADR-371 D4: the value
                                                        tail — a `setting` head
                                                        fires only for this
                                                        state word (analysis.
                                                        head-value-tail elsewhere);
                                                        on a two-noun gerund the
                                                        one word is a counterpart
                                                        (`giving to Tobias`) *)
               | "to" name ]                          (* ADR-372 D1: several words
                                                        or an article after `to`
                                                        are a counterpart (`giving
                                                        to Mrs Kettle`) *)
               [ "anything" "as" "the" WORD ]          (* role tail: the owner is
                                                        the named role *)
             | "every" "turn" ;                      (* `on` only *)
head         = actor gerund { "," gerund }           (* explicit actor — ADR-327 D1:
                                                        the owner is the action's
                                                        object *)
             | gerund { "," gerund }                 (* bare — the owner's own
                                                        action; legal only in the
                                                        player's or a person's
                                                        block (analysis.head-bare-
                                                        outside-actor) *)
             | "hearing" ARTICLE WORD ;              (* ADR-374 D6: a listener's
                                                        reaction, `after` only — the
                                                        hearer is the block's owner
                                                        (a person or a thing), the
                                                        WORD a declared sound. The
                                                        one tailed event verb: no
                                                        actor stands before its tail.
                                                        analysis.hearing-not-listener,
                                                        -unknown-sound, -after-only,
                                                        -actor, -needs-article *)
                                                     (* ADR-368 D1: a head may list
                                                        gerunds; it means one clause
                                                        per gerund, same actor, tail,
                                                        modifiers and body. The list
                                                        ends at a modifier comma,
                                                        `anything`, `while`, `during`
                                                        or EOL. A repeat is parse.head-
                                                        gerund-repeated; a comma item
                                                        that is not one word is
                                                        parse.head-gerund (`and`/`or`
                                                        are not separators). `on every
                                                        turn` takes no list. *)
actor        = "the" "player"                        (* the ROLE — resolved at fire
                                                        time, never a compile-time
                                                        entity *)
             | name ;                                (* a character: `Jack`, `the
                                                        wandering mercenaries`; a
                                                        room/thing or the block's
                                                        own owner is an analyzer
                                                        error (analysis.head-actor /
                                                        analysis.head-actor-is-owner) *)
gerund       = WORD ;                                (* the LAST head word — split
                                                        syntactically, never guessed
                                                        (D3); `<gerund> it` is the
                                                        removed pre-ADR-327 spelling,
                                                        parse.removed-head-it *)
counterpart  = [ "at" | "for" | "from" | "about" | "in" ] ARTICLE name
             | ( "at" | "for" | "from" ) name ;      (* ADR-372 D1: read from the
                                                        END of the head — the tail
                                                        opens at the last article,
                                                        one preposition before it
                                                        included; with none, at the
                                                        last bare `at`/`for`/`from`.
                                                        Taken only when an actor and
                                                        a gerund stand before it.
                                                        One gerund only (parse.head-
                                                        counterpart-list); the
                                                        gerund's action consults two
                                                        nouns (analysis.head-
                                                        counterpart-one-noun); the
                                                        name is a thing (…-unknown)
                                                        and not the owner (…-is-
                                                        owner). A bare proper name
                                                        after the gerund is
                                                        analysis.head-counterpart-
                                                        bare-name. *)
clause-modifier = "once"                          (* D5: one lifetime firing *)
             | ( "before" | "after" ) WORD ;      (* trait ordering *)

(* `refuse`/`refuse when`/`must` inside an `after` body are parse errors;
   `after every turn` is a parse error. A role tail on a bare head is
   parse.on-head — a role head names who acts. *)

(* Syntactic `it`/`its` (ADR-327 D2/D8): removed from statement, condition,
   and possessive positions everywhere EXCEPT a `define trait` body, where
   they mean the carrier, and a `define condition`, where `it` is the open
   condition's quantified subject. Elsewhere: analysis.it-removed, fix-it
   naming the block owner. Scene heads (`on parting:` / `on resuming:` /
   `on refusing:` in `define conversation`, `on leaving` in a scene) are
   not on-clauses and are untouched (D4). *)

(* Event verbs (catalog EVENT_VERBS, gerund register): `entering` on ROOMS
   binds to the movement event; on any other thing — scenery, enterables —
   it is the entering ACTION's interceptor ("someone enters this thing",
   GH #341), like any consulted gerund; on REGION blocks (ADR-236 D6)
   `after the player entering` / `after the player leaving` bind to the region's crossing
   events (region_entered/region_exited), fired per boundary actually
   crossed. `leaving` (ratchet R3) exists ONLY on region blocks — a load
   error anywhere else. Region blocks also host `on every turn` (D4):
   presence = the player is in a member room, transitive through nesting. *)


(* ---- start block (ADR-327 D10) ----------------------------------------- *)

start-block  = "before" "the" "game" "starts" NL >>> { statement } "end" "before" NL ;
                                                           (* exactly one per story
                                                              (analysis.duplicate-start-block;
                                                              analysis.start-block-missing when
                                                              absent), and it must assign the
                                                              player role on some path
                                                              (analysis.start-block-no-role).
                                                              Effect statements only: `phrase`
                                                              and `emit` are analysis.start-
                                                              block-narration — the block runs
                                                              before any turn exists to carry
                                                              prose; the story header's
                                                              `prologue:` is that seam.
                                                              `create the player` is REMOVED
                                                              (parse.removed-create-player) *)

(* ---- create ------------------------------------------------------------ *)

create       = "create" name [ "," composition { "," composition } ] NL
               >>> { create-line } ;                       (* ADR-359 D1: every block names
                                                              exactly one kind, and the kind
                                                              leads the block — the first
                                                              composition line opens with
                                                              ARTICLE KIND-NOUN
                                                              (analysis.missing-kind-noun,
                                                              analysis.kind-not-first).
                                                              ADR-362 D1: that line may fold
                                                              onto the head after a comma
                                                              (`create the Den, a room`); it
                                                              is the block's first
                                                              composition line, nothing else
                                                              folds (D3), and a folded term
                                                              is one word — words after it
                                                              are parse.create-trailing (D5,
                                                              as are words after an unfolded
                                                              name) *)
create-line  = "aka" alias { "," alias } NL
             | "pronouns" WORD NL                          (* ADR-242 D5 (ratchet H2):
                                                              person blocks only (analyzer
                                                              gate); a standard set
                                                              (he|she|it|they) or a
                                                              `define pronouns` name;
                                                              absent = by-number fallback,
                                                              never an injected default *)
             | states-line
             | score-line
             | counter-line                                (* ADR-264 D1 *)
             | holds-line                                  (* ADR-369 D2 *)
             | vehicle-line                                (* ADR-366 D2, D5, D7 *)
             | admits-line                                 (* ADR-366 D6 *)
             | position-block                              (* ADR-366 D5a *)
             | pushing-block                               (* ADR-378 D6b *)
             | expanse-line                                (* ADR-376 D2, D6, D10: under
                                                              `use expanses` *)
             | sight-line | seen-from-afar-line            (* ADR-376 D6: on a landmark
                                                              room or an instrument *)
             | landmarks-block                             (* ADR-376 D2 *)
             | composition { "," composition } NL          (* pre-blank paragraph only;
                                                              a kind noun takes no `with`
                                                              settings — parse.kind-
                                                              setting, or parse.removed-
                                                              capacity-setting for the
                                                              retired `max items`, `max
                                                              weight`, `capacity` (ADR-369
                                                              D2a) *)
             | "playable" NL                             (* ADR-327 D10: this character may
                                                              hold the player role. Person
                                                              blocks only (analysis.playable-
                                                              non-person); who HOLDS the role
                                                              is a run-time fact the start
                                                              block decides, never a create
                                                              line *)
             | placement NL                                (* on a room, `in the <region>`
                                                              is membership (ADR-360 D4):
                                                              one region per room
                                                              (analysis.room-two-regions);
                                                              a room `in` anything else is
                                                              analysis.room-in-non-region;
                                                              a non-room placed in a
                                                              region is analysis.thing-in-
                                                              region *)
             | "wears" name NL
             | "carries" name NL                           (* ADR-230 Phase 6: start
                                                              inventory, the missing
                                                              half of `wears` *)
             | landing-line                                (* ADR-325 D5: region
                                                              blocks only *)
             | room-group                                  (* ADR-360 D1/D2: region
                                                              blocks only (analysis.room-
                                                              group-owner). Region
                                                              membership is a group, or a
                                                              room's own `in the <region>`
                                                              placement (D4); `containing`
                                                              is removed (parse.removed-
                                                              containing) and placement
                                                              lines on a region block are
                                                              an error, so regions do not
                                                              nest (D5) *)
             | exit-table                                  (* ADR-360 D3: region blocks
                                                              only (analysis.exit-table-
                                                              owner); one of each kind
                                                              (analysis.exit-table-
                                                              duplicate) *)
             | exit [ "," "one-way" ]
               [ "admits" admits-list ] [ "while" condition ] NL
                                                           (* ADR-378 D6, D3: on a single
                                                              exit line only, `admits` says
                                                              who may take this way (a
                                                              steered vehicle, `pushing`)
                                                              and `while` makes the exit
                                                              exist only while the
                                                              condition holds — hidden, for
                                                              every reader, which is not
                                                              blocked. On an `exits:` line
                                                              they are parse.exits-line-
                                                              admits / parse.exits-line-
                                                              while; in a table row
                                                              parse.exit-row-admits /
                                                              parse.exit-row-while *)
                                                           (* exit; `through the <door>`
                                                              tail (ADR-234 D1, ratchet
                                                              R2) is the ONE door
                                                              relationship form — the
                                                              door must be declared, the
                                                              reverse exit is inferred
                                                              (opposite direction), a
                                                              mirrored far-room line is
                                                              legal only as the exact
                                                              mirror. `, one-way` (ADR-234
                                                              D4, wired 2026-09-03, GH
                                                              #327): the written
                                                              direction only — no reverse
                                                              exit, a door on the line is
                                                              one-way. Placement
                                                              lines on a door block are
                                                              a load error — a door's
                                                              location IS its room pair
                                                              (loader places it in the
                                                              declaring room; present at
                                                              BOTH rooms, ADR-238) *)
             | exits-line                                  (* ADR-362 D2: the room's
                                                              exits on one line *)
             | passage-line                                (* ADR-378 D1: an exit named
                                                              by its command *)
             | exit-key "is" "blocked" [ "while" condition ] ":" phrase-key NL
                                                           (* blocked exit *)
             | exit-key "is" "deadly" ":" phrase-key NL    (* deadly exit (ADR-227); the
                                                              `while` form is parsed and
                                                              refused (analysis.deadly-
                                                              while-unsupported) *)
             | phrase-override                             (* per-entity override, CP3/Z3b *)
             | room-name-block                             (* the authored location
                                                              heading *)
             | "first" "time" NL >>> prose-paragraph       (* Z1: first-visit description;
                                                              rooms only *)
             | on-clause
             | timer-clause | move-clause                  (* ADR-325 D3e / D3h: event
                                                              clause heads on the owner *)
             | mood-line | feels-line | knows-line | thinks-line
                                                           (* ADR-310 character-model
                                                              lines: person blocks only
                                                              (analysis.character-line-
                                                              person-only) *)
             | spreads-line
             | resists-line
             | influence-block
             | goal-block                                  (* ADR-310 D8; person blocks
                                                              with a character model *)
             | temperament-line                            (* ADR-318 normative lines:
             | never-line                                     the same person-only
             | protects-line                                  gate *)
             | "answers" "honestly" NL
             | honor-line
             | "burdened" "by" name NL                     (* ADR-318 D8: pre-story
                                                              guilt; the topic must be
                                                              held by a `knows` line
                                                              (analysis.burdened-
                                                              unheld); one per topic *)
             | "code" WORD NL                              (* ADR-318 D4: a `define
                                                              code` bundle, unioned
                                                              with the block's own
                                                              never/obligation lines *)
             | prose-paragraph ;                           (* post-blank: description;
                                                              consecutive bare paragraphs
                                                              append *)

(* ---- the character model (ADR-310) ------------------------------------- *)

(* Words the author writes, numbers the runtime owns. Every closed word list
   cited below lives in src/character-manifest.ts; the parser collects the
   words raw and the analyzer resolves them, so a miss is a diagnostic naming
   the vocabulary, never a silent drop.

   Two D2–D5 constructs are NOT lines of their own — they ride the composition
   list above:
   - personality (D2): `a person, very honest, cowardly` — an adjective from
     the manifest or a `define personality` name, optionally preceded by an
     intensity word (slightly | somewhat | very | extremely). Personality
     words never enter the parser's noun vocabulary (D12).
   - cognitive-profile (D4): `cognitive-profile <name> [with <dimension>
     <value> and …]` — the name is a preset (clear-headed | fixated |
     elsewhere | loosened | fogged | braced | unmoored | unquiet) or a
     `define profile` name; each `with` pair overrides one of the five
     dimensions (perception, belief-formation, coherence, lucidity,
     self-model); `while` is refused (analysis.profile-conditional).
   Decay (D6) is never declared. *)

mood-line    = "mood" WORD NL ;                            (* D3: a platform mood or a
                                                              `define mood` name;
                                                              `change mood to <word>`
                                                              is the transition *)
feels-line   = "feels" disposition [ "toward" ] name NL ;  (* D3: longest-matched
                                                              against the manifest —
                                                              `wary of` / `devoted to`
                                                              are two words; a bare
                                                              proper name after the
                                                              disposition needs
                                                              `toward` (parse.feels-
                                                              target). Any entity may
                                                              stand where the player
                                                              does (D14) *)
disposition  = WORD [ WORD ] ;                             (* despises | hates |
                                                              dislikes | wary of |
                                                              neutral | likes | trusts
                                                              | devoted to *)
knows-line   = "knows" name { "," WORD } NL ;              (* D3: a valueless topic,
                                                              then order-free one-word
                                                              slots — at most one
                                                              source (witnessed | told
                                                              | inferred | assumed |
                                                              hallucinated), one
                                                              confidence (uncertain |
                                                              suspects | believes |
                                                              certain), and `confided`
                                                              (ADR-318 D4). A source
                                                              is required (analysis.
                                                              knows-missing-source) *)
thinks-line  = "thinks" name "is" name { "," WORD } NL ;   (* D14: a valued belief —
                                                              the fact is a `define
                                                              fact` name, the value one
                                                              of its declared values;
                                                              slots as `knows`, minus
                                                              `confided`. One level of
                                                              belief: no `thinks X
                                                              thinks …` *)
spreads-line = "spreads" "nothing" NL                      (* D10: `mute` said in
                                                              English — `mute` itself
                                                              is parse.spreads-
                                                              tendency *)
             | "spreads" [ topic-list ] [ "chatty" ] "to" WORD
               [ "," "except" name-ref-list ] NL ;         (* audience: trusted |
                                                              anyone | allied. No topic
                                                              list = no topic filter
                                                              on the character's
                                                              chatty profile;
                                                              `chatty` is optional
                                                              flavor (the form implies
                                                              it — `selective` is not
                                                              a word) *)
topic-list   = name { ( "," | "and" ) name } ;
name-ref-list = name { "," [ "and" ] name | "and" name } ; (* Oxford `and` welcome *)
resists-line = "resists" WORD [ "," "except" "from" name ] NL ;
                                                           (* D9: the influence name an
                                                              exerter invented; one
                                                              line, binary — the
                                                              target resists or does
                                                              not. `except from` takes
                                                              a name or a kind
                                                              (`a woman`) *)
influence-block = "influence" WORD { "," WORD } NL         (* D9: author-invented name,
                                                              then mode (passive |
                                                              active) and range
                                                              (proximity | targeted |
                                                              room), order-free *)
               >>> { influence-line }
               "end" "influence" NL ;
influence-line = "clouds" "focus" NL
             | "makes" WORD WORD NL                        (* <axis> <word>: axis is
                                                              mood or threat, the word
                                                              from that axis's
                                                              vocabulary (analysis.
                                                              unknown-influence-axis /
                                                              -effect-word) *)
             | "phrase" phrase-key "on"
               ( "witnessed" | "resisted" | "expired" ) NL ;
                                                           (* message hooks reuse
                                                              `phrase`; one per
                                                              outcome *)

(* The character model's top-level definitions (ADR-310 D4/D5/D14). *)
define-fact  = "define" "fact" name NL                     (* D14: the closed value set
                                                              a `thinks` line draws
                                                              from; at least one value
                                                              (analysis.fact-empty), no
                                                              repeats *)
               >>> { name-ref-list NL }
               "end" "fact" NL ;
define-profile = "define" "profile" WORD NL                (* D4: a named cognitive
                                                              profile — one row per
                                                              dimension, each at most
                                                              once (analysis.profile-
                                                              row-duplicate); unstated
                                                              dimensions inherit from
                                                              `clear-headed` *)
               >>> { WORD WORD NL }                        (* <dimension> <value> *)
               "end" "profile" NL ;
define-mood  = "define" "mood" WORD "like" WORD
               [ "," "but" WORD ] NL ;                     (* D5: a custom mood anchored
                                                              at a platform mood, nudged
                                                              by restless | stiller |
                                                              darker | brighter *)
define-personality = "define" "personality" WORD NL ;      (* D5: a new adjective; a
                                                              platform word, an
                                                              intensity, or a trait
                                                              name is analysis.
                                                              personality-shadows-* *)

(* ---- the normative layer (ADR-318) ------------------------------------- *)

(* Forces, act categories, obligation words, and face-acts are closed
   vocabularies in src/character-manifest.ts; each line's words are collected
   raw and resolved by the analyzer (analysis.unknown-force / -act-category /
   -face-act). Person blocks only. *)

temperament-line = "temperament" WORD [ "with" force-pair { "and" force-pair } ]
                   [ "while" WORD ] NL                     (* D3: a `define
                                                              temperament` name with
                                                              optional overrides *)
             | "temperament" force-pair { "and" force-pair }
               [ "while" WORD ] NL ;                       (* D7: an inline anonymous
                                                              ordering. One-token
                                                              lookahead on `over`
                                                              tells the forms apart.
                                                              `while <state>` binds
                                                              the ordering to one of
                                                              the block's `states:`
                                                              (analysis.temperament-
                                                              unknown-state); two
                                                              bound to the same state
                                                              is analysis.temperament-
                                                              tie. Never mutated —
                                                              the state ratchet is the
                                                              only lever *)
force-pair   = WORD "over" WORD ;                          (* fear | desire | duty |
                                                              honor | love; a force
                                                              over itself is analysis.
                                                              temperament-self-pair *)
never-line   = "never" WORD { WORD }
               [ "," "except" [ "to" "protect" ] scope-ref ] NL ;
                                                           (* D4: the words before the
                                                              comma longest-match an
                                                              act category (betray a
                                                              confidence | lie | harm
                                                              | steal | break a promise
                                                              | abandon | trespass),
                                                              with a trailing scope for
                                                              harm/abandon *)
protects-line = "protects" scope-ref NL ;                  (* D4/D5: an obligation —
                                                              compiles to a standing
                                                              goal *)
honor-line   = "honor" [ WORD ] "before" scope-ref
               [ "," "except" name-ref-list ] NL ;         (* D7: bare = the full
                                                              face-act bundle; a WORD
                                                              names a `define honor`
                                                              selection. Scope is the
                                                              audience whose presence
                                                              engages it *)
scope-ref    = "anyone" | name ;                           (* D4/D9-D10 grammar: anyone,
                                                              a kind (`a servant`), or
                                                              an entity (`the
                                                              children`) *)
define-temperament = "define" "temperament" WORD NL        (* D3: at least one pair
                                                              (parse.temperament-
                                                              empty); no repeats *)
               >>> { force-pair NL }
               "end" "temperament" NL ;
define-code  = "define" "code" WORD NL                     (* D4: a named principle
                                                              bundle; at least one
                                                              line (parse.code-empty) *)
               >>> { never-line | protects-line | "answers" "honestly" NL }
               "end" "code" NL ;
define-honor = "define" "honor" WORD NL                    (* D7: a selective face-act
                                                              bundle — one face-act per
                                                              line (backs down | shows
                                                              fear | admits fault |
                                                              pleads | accepts insult |
                                                              caught lying); at least
                                                              one (parse.honor-empty) *)
               >>> { WORD { WORD } NL }
               "end" "honor" NL ;
define-topic = "define" "topic" WORD WORD { WORD } "as" WORD NL ;
                                                           (* D12a: alias a witnessed-
                                                              act topic — `<actor>
                                                              <act> as <alias>`, at
                                                              least two words before
                                                              `as`; one alias per act
                                                              (analysis.witnessed-
                                                              duplicate) *)

(* A goal (ADR-310 D8): a named, prioritized plan a character pursues on its
   own turns, one step per turn. *)
goal-block   = "goal" WORD "," WORD NL                     (* name, priority: critical |
                                                              high | medium | low
                                                              (analysis.unknown-priority) *)
               >>> { goal-line }
               "end" "goal" NL ;
goal-line    = "active" "when" condition NL                (* at most one; absent =
                                                              always active *)
             | "seek" name [ "in" name ] NL                (* walk toward an entity or
                                                              room, one room per turn *)
             | "acquire" name NL                           (* wait until in the room,
                                                              then `taking` *)
             | "wait" "for" condition NL
             | "move" "to" name NL                         (* walk to a room *)
             | "act" phrase-key NL
             | "say" phrase-key [ "to" name ] NL
             | "give" name "to" name NL                    (* blocked unless held; waits
                                                              for the recipient *)
             | "drop" name [ "in" name ] NL
             | verb-words NL ;                             (* ADR-329 D10: an action's own
                                                              words, the block's owner
                                                              implied as the actor —
                                                              `open the door`, `go east`,
                                                              `conjure the key into the
                                                              Vault`. Matched against the
                                                              story's and the standard
                                                              grammar shapes exactly as
                                                              the acting statement is;
                                                              a `taking` / `giving` /
                                                              `dropping` shape folds onto
                                                              acquire / give / drop
                                                              (their planning half kept);
                                                              anything else performs
                                                              NOW, the action's validate
                                                              the only gate, a refusal
                                                              retried next turn. No
                                                              `when` suffix on a step —
                                                              `wait for` is the guard
                                                              (parse.goal-step) *)

(* ---- chapters (ADR-330) — a `use chapters` extension ------------------- *)

(* Chapters are declared, not scripted: one block names every chapter with
   the moment it begins, and a chapter ends when the next begins — there is
   no `end chapter`. Admitted only under `use chapters` (analysis.chapters-
   needs-use). Rows are in declaration order and that order is the
   chapters' order; the opening row — exactly one on `the game starts` —
   must be first (analysis.chapter-no-opening / -two-openings /
   -opening-not-first); a repeated name is analysis.duplicate-chapter; a
   second block is analysis.duplicate-chapters. The runtime, the
   `story.chapter` channel packet, and the `during`/`before`/`after`
   predicates are the extension's (ADR-330 D4/D5) and land with it. *)

define-chapters = "define" "chapters" NL
                  >>> { chapter-row }
                  "end" "chapters" NL ;
chapter-row  = WORD "-" rest-of-line NL                    (* <name> - <title>: the
                                                              name is one kebab word,
                                                              what conditions say and
                                                              never printed; the title
                                                              is raw prose to the end
                                                              of the line — a numeral
                                                              or a colon in it means
                                                              nothing to the grammar *)
               >>> [ prose-paragraph ]                     (* the description — rides
                                                              the packet with the title;
                                                              empty when absent *)
               "begins" "when" chapter-trigger NL ;        (* required; once per row
                                                              (parse.chapter-no-trigger
                                                              / parse.chapter-trigger) *)
chapter-trigger = "the" "game" "starts"                    (* the ADR-327 D10 start
                                                              moment *)
             | "the" "player" "visits" name
               "for" "the" "first" "time"                  (* the role-holder's first
                                                              arrival in a ROOM
                                                              (analysis.chapter-visit-
                                                              not-room) — any arrival,
                                                              an authorial move included *)
             | value-expr "expires"                        (* an ADR-325 timer, by its
                                                              possessive from the story
                                                              level (analysis.unknown-
                                                              timer) *)
             | name "becomes" WORD ;                       (* an entity, or `the story`,
                                                              reaching a declared state
                                                              (analysis.undeclared-
                                                              state). `<entity> moves`
                                                              is refused by name *)

(* ---- timers, places, landings (ADR-325) -------------------------------- *)

(* A timer counts turns by name and never sees a number (D3): the author
   names the turns, the timer steps through them once started, and ends in
   the one state every timer shares, `expired` — never written (parse.timer-
   expired). ADR-264's counters are TALLIES and take raise/lower/set; a
   timer takes only the timer verbs (analysis.timer-verb-on-tally). *)

define-timer = "define" "timer" WORD [ "for" name ] NL     (* D3a: owned by an entity
                                                              or the player (`for`),
                                                              else by the story *)
               >>> { timer-line }
               "end" "timer" NL ;
timer-line   = WORD NL [ >>> prose-paragraph ]             (* one named turn; the body
                                                              is spoken the turn it is
                                                              reached, as a `phrase`
                                                              body is *)
             | "meanwhile" [ "," "one" "chance" "in" NUMBER ] NL
               >>> { statement }                           (* every running turn,
                                                              occasionally with the
                                                              chance; at most one *)
             | "interrupted" "one" "chance" "in" NUMBER NL ;
                                                           (* per running turn, the
                                                              chance it expires now
                                                              instead of stepping; at
                                                              most one *)
timer-clause = "when" value-expr "expires"
               [ [ "," ] "while" condition ] NL            (* D3e: expiry is an event.
                                                              Bare name inside the
                                                              owner's block, possessive
                                                              from outside (`the
                                                              player's waiting`) *)
               >>> { statement } "end" "when" NL ;
move-clause  = "when" value-expr "moves"
               [ [ "," ] "while" condition ] NL            (* D3h: the completed move
                                                              of the named entity —
                                                              a reaction, never a
                                                              refusal (that is the
                                                              mover's own `on going`);
                                                              create blocks only *)
               >>> { statement } "end" "when" NL ;
landing-line = "landing" name NL                           (* D5: where a thing put in
                                                              the region lands; the
                                                              region becomes a place *)
             | "landing" "," LANDING-STRATEGY ":" name-ref-list NL ;
                                                           (* a list must say how to
                                                              choose, a single room
                                                              takes no strategy
                                                              (parse.landing-strategy);
                                                              one line per region;
                                                              every room contained
                                                              (analysis.landing-not-
                                                              contained); mutable with
                                                              `set <region>'s landing
                                                              to <room>` *)
LANDING-STRATEGY = "randomly" | "cycling" | "stopping" ;   (* drawn on a per-region
                                                              seeded stream *)

phrase-override = "phrase" phrase-key
                  [ "," STRATEGY ] [ "while" condition ] ":" NL
                  variant { "or" NL variant } ;
                  (* `or` stands alone at the header's indent; repeating
                     `detail` keys (`<id>.detail.2`, …) are analyzer-derived *)
                  (* `detail` requires `while` and is single-text; `while` on
                     lifecycle channels / ordinary overrides is an error.
                     Reserved channel keys (present, entered, exited,
                     disappeared, detail) cannot be declared bare or pushed
                     via statements — analyzer gates. *)

room-name-block = "room" "name" [ "while" condition ] ":" NL
                  >>> prose-paragraph ;
                  (* The location heading a player reads, authored apart from the
                     entity's name. Repeating blocks are the ARMS, first-match-wins
                     at runtime; the analyzer numbers them into the flat phrase
                     table as `<id>.room-name`, `<id>.room-name.2`, … exactly as it
                     numbers repeating `detail` keys, so the IR gains no new shape.
                     Gates: at most one unconditional arm and nothing may follow it
                     (analysis.room-name-duplicate-unconditional,
                     analysis.room-name-dead-arm); one text per arm, no `or`
                     variants (analysis.room-name-variants); legal only on a room,
                     in a `rooms` group, or on an `enterable` thing — a region
                     contributes no heading (ADR-360 D6; analysis.room-name-owner). *)

room-group   = "rooms" stem NUMBER "to" NUMBER NL >>> { group-line } ;
                  (* ADR-360 D1: one room per whole number from the first to the
                     last, inclusive, named `<stem> <n>` and taking the article
                     `the`, exactly the room `create the <stem> <n>` makes. The
                     line is a group only in this shape, so a line that merely
                     begins with `rooms` is not one. A range that counts down,
                     a number with a leading zero, or more than 1000 rooms is
                     analysis.room-group-range; a created name that collides is
                     analysis.duplicate-entity. *)
stem         = WORD { WORD | NUMBER } ;                    (* every token between `rooms`
                                                              and the last three, so a
                                                              stem may hold `to`: `rooms
                                                              Road to Ruin 1 to 3` *)
group-line   = composition { "," composition } NL          (* trait adjectives only; the
                                                              kind is always `room` *)
             | "aka" alias { "," alias } NL
             | admits-line                                 (* ADR-366 D6: copied to
                                                              every room the group
                                                              creates *)
             | room-name-block                             (* copied under each room's
                                                              own keys (D8) *)
             | "first" "time" NL >>> prose-paragraph
             | prose-paragraph ;                           (* one shared description
                                                              key (D8). Any other line is
                                                              analysis.room-group-line
                                                              (D2); a group with no
                                                              description warns once on
                                                              its `rooms` line (D7) *)

exit-table   = "exits" [ "," "one-way" ] NL >>> exit-row { exit-row } ;
                  (* ADR-360 D3: a region's exits, one row per member room. In
                     `exits, one-way` every exit is one-way; a plain table's exits
                     infer their reverse. A row's exits join the room's own, so
                     two in one direction are analysis.duplicate-exit (D3a). *)
exit-row     = name ":" exit { "," exit } NL ;            (* the row's room must be a
                                                              member (analysis.exit-row-
                                                              not-member). A blocked or
                                                              deadly exit here is
                                                              parse.exit-row-blocked; a
                                                              row exit's own `, one-way`
                                                              is parse.exit-row-one-way *)
exits-line   = "exits" [ "," "one-way" ] ":" exit { "," exit } NL ;
                  (* ADR-362 D2: the same exits as one per line, each the shared `exit`
                     production with a span of its own (D4). `exits, one-way:` makes
                     every exit on the line one-way; a per-exit `, one-way` is
                     parse.exits-line-one-way, a blocked or deadly exit on the line is
                     parse.exits-line-blocked, leftover words are parse.exit-trailing, and
                     an empty line is parse.exits-line-empty. Legal only in a room block
                     (analysis.exit-line-owner); in a `rooms` group body it is
                     analysis.room-group-line. The colon tells it from ADR-360's table. A
                     blocked line beside it guards that exit as it would a single line. *)
passage-line = "passage" passage-words { "or" passage-words }
               "to" name [ "through" name ] [ "while" condition ] NL ;
                  (* ADR-378 D1–D3: an exit the player takes by typing its words
                     (`passage climb the rope or climb up to the Loft`), one line
                     per way, the first form its name and the key
                     `passage:<first form, hyphenated>`. One-way by construction:
                     `, one-way` is analysis.passage-one-way. The words are grammar
                     only where the passage is and while it exists (D2, D3). Not a
                     direction, so it takes no `admits` (parse.exit-trailing). Two
                     passages on one room sharing a form are analysis.duplicate-
                     exit. Rooms only (analysis.exit-non-room). *)
passage-words = WORD { WORD } ;                            (* the words the player types;
                                                              none `to` or `or`, which
                                                              separate; an empty or non-
                                                              word form is parse.passage-
                                                              words *)
exit-key     = DIRECTION | "passage" passage-words ;       (* what a blocked or deadly
                                                              line names: a compass
                                                              direction, or a passage the
                                                              room declares by any of its
                                                              forms (analysis.passage-
                                                              unknown) *)
exit         = DIRECTION "to" ( name | "outside" )
               [ "through" name ] ;                        (* the one exit production: a
                                                              room's exit line, a table
                                                              row and ADR-362's `exits:`
                                                              line all read it. `outside`
                                                              (ADR-366 D7) is legal only
                                                              in a room some vehicle
                                                              lists `aboard:` (analysis.
                                                              outside-not-aboard) and
                                                              resolves on each use to
                                                              the vehicle's current room *)

composition  = ( ARTICLE KIND-NOUN | WORD )                (* article => kind noun;
                                                              bare => trait *)
               [ "with" setting { "and" setting } ]
               [ "while" condition ]
             | "costs" NUMBER WORD                         (* ADR-372 D5: a price — a
                                                              whole number (analysis.
                                                              costs-price) of a currency
                                                              some playable character
                                                              carries as a counter
                                                              (analysis.costs-counter-
                                                              unknown); the buying
                                                              behavior spends the buyer's
                                                              own counter. Malformed is
                                                              parse.costs *)
             | "powered" "by" ARTICLE name
               { "and" ARTICLE name }                      (* ADR-374 D10: power
                                                              sources — it runs while
                                                              every one is inside it;
                                                              a switchable container
                                                              only (analysis.powered-
                                                              not-switchable, -not-
                                                              container). Malformed is
                                                              parse.powered-by *)
             | "attached" "to" ARTICLE name                (* ADR-373 D1: the anchor, the
                                                              adjective's single-entity
                                                              value (analysis.setting-
                                                              names-no-entity); taking
                                                              refuses the thing, pulling
                                                              frees it when `detachable`
                                                              sits beside it (alone that
                                                              is analysis.detachable-not-
                                                              attached; `fragile` without
                                                              `breakable` is analysis.
                                                              fragile-not-breakable).
                                                              Malformed is parse.
                                                              attached-to *)
             | "starts" STATE-INIT ;                       (* ADR-231 D5a initializer:
                                                              sets the paired trait's
                                                              initial value; pairing
                                                              analyzer-gated. One-token
                                                              lookahead: "starts" "in"
                                                              stays placement; any other
                                                              word after "starts" is a
                                                              parse error *)
STATE-INIT   = "locked" | "unlocked" | "closed" | "open"
             | "off" | "on" | "broken"                     (* ADR-373 D7: `broken` pairs
                                                              with `breakable` *)
             | "lit" | "unlit" ;                           (* ADR-374 D9: pair with
                                                              `light-source` *)
KIND-NOUN    = "thing" | "room" | "door" | "person"
             | "container" | "supporter" | "region"
             | "vehicle"
             | "expanse" ;                                 (* ADR-376 D2: `expanse` is
                                                              `use expanses` vocabulary
                                                              (analysis.expanses-needs-
                                                              use) — a bounded space
                                                              with coordinates, written
                                                              with `size:` and a
                                                              `landmarks` block.
                                                              ADR-366 D1: `vehicle` is a
                                                              kind, enterable by
                                                              construction (`enterable`
                                                              beside it is analysis.
                                                              vehicle-already-enterable).
                                                              ADR-359 D1: the WORD of a kind
                                                              composition; any other word
                                                              is analysis.unknown-kind-noun.
                                                              `a thing` is the plain object,
                                                              and never sits beside another
                                                              kind (analysis.thing-with-kind);
                                                              a kind never takes `while`
                                                              (analysis.conditional-kind) *)
setting      = ARTICLE name                                (* ratchet R3 (ADR-234 D6):
                                                              article directly after
                                                              `with`/`and` = the
                                                              adjective's single-entity
                                                              value (`lockable with the
                                                              iron key`, `cuttable with
                                                              the knife`). The old
                                                              `key`/`tool` keywords are
                                                              parse errors with fix-its *)
             | WORD { WORD }
               ( NUMBER | STRING | WORD | name-list-value
               | ARTICLE name ) ;
                                                           (* last token(s) = the value.
                                                              Keyed ARTICLE-name values
                                                              remain for authored-trait
                                                              NAMED data fields (`with
                                                              food the handful of feed`)
                                                              — the keyword is the field
                                                              name. Extension adjectives
                                                              (ADR-215: combatant,
                                                              weapon, the NPC library)
                                                              take manifest-typed
                                                              fields — unknown keys and
                                                              mistyped values are
                                                              compile errors *)
name-list-value = "[" name { "," name } "]" ;              (* ADR-215: only where a
                                                              manifest declares a list
                                                              field (patrol route,
                                                              allowed-rooms, …) *)
placement    = ( "in" | "on" ) ARTICLE name
               [ "at" NUMBER "," NUMBER ]                  (* on + article = placement.
                                                              `at <x>, <y>`: ADR-376 D3,
                                                              D10 — a position in an
                                                              expanse, on an `open`
                                                              vehicle or a `floats`
                                                              thing only (analysis.
                                                              expanse-not-open-vehicle,
                                                              at-not-expanse,
                                                              coordinates-outside-
                                                              expanse, placement-missing-
                                                              at; parse.placement-at) *)
             | "in" ARTICLE name { "," ARTICLE name }
               "and" ARTICLE name                          (* ADR-374 D2: a backdrop,
                                                              present in every listed
                                                              room; scenery, rooms and
                                                              `in` only (analysis.
                                                              backdrop-not-scenery,
                                                              -not-room, placement-list-
                                                              relation). `in the <region>`
                                                              on scenery places it in
                                                              every member room. `and`
                                                              separates places as in every
                                                              name list *)
             | "starts" "in" name ;                        (* on + bare word = on-clause *)
DIRECTION    = "north" | "south" | "east" | "west"
             | "northeast" | "northwest" | "southeast" | "southwest"
             | "up" | "down"
             | "in" | "out" ;                                 (* ADR-369 D3: `in to <room>`
                                                              is an exit, `in the <room>`
                                                              is placement — the article
                                                              decides, as it does for `on` *)


(* ---- define ------------------------------------------------------------ *)

define-condition = "define" "condition" WORD ":" condition NL ;
define-phrase    = "define" "phrase" phrase-key [ "," ( STRATEGY | "verbatim" ) ]
                   [ "while" condition ] NL                (* CP1' trailing gate *)
                   variant { "or" NL variant } "end" "phrase" NL ;
                   (* verbatim: single variant, line structure + relative
                      indentation preserved; no strategies, no "or" variants *)
variant          = prose-paragraph ;
define-phrases   = "define" "phrases" LOCALE NL >>> { phrase-entry } ;
phrase-entry     = phrase-key ":" NL prose-paragraph ;     (* prose block only *)
(* define-verb REMOVED (ADR-270 D7, 2026-07-26, Chord 3.0.0): `extend action`
   subsumes it — the parser emits parse.removed-define-verb with a fix-it. *)
pattern          = pattern-elem { pattern-elem } ;         (* ADR-267 D1: shared with pattern-line
                                                              and the ADR-270 alteration blocks *)
pattern-elem     = plain-elem | "[" plain-elem "]" ;       (* [x] = optional (D9) *)
plain-elem       = WORD { "or" WORD } | "the" WORD ;       (* or = alternation, ONE rule (D8);
                                                              "the" WORD = slot (D15) *)
STRATEGY        = "randomly" | "cycling" | "stopping" | "sticky" | "first-time" ;
                   (* Z5: mirrors the Choice selectors 1:1. `ordered`/`once`
                      are retired — load errors naming `stopping`/`first-time`.
                      The RULE modifier `, once` (D5) is a different site and
                      still parses. *)


(* ---- Traits, actions, sequences ---------------------------------------- *)

define-trait   = "define" "trait" WORD NL
                 { trait-line }
                 "end" "trait" NL ;
trait-line     = "data" NL >>> { trait-field }
               | states-line
               | score-line
               | "phrases" LOCALE NL >>> { phrase-entry }
               | on-clause ;
trait-field    = field-words ":" [ "optional" ]
                 ( "entity" | "number" | "name"
                 | "one" "of" WORD { "," WORD } )
                 [ "," "starts" token ] NL ;
                 (* the `flag` field type is a parse error pointing at
                    trait `states` *)

define-action  = "define" "action" WORD [ "while" condition ] NL action-line* ;
                                                           (* dedent-terminated. ADR-378
                                                              D5 (ADR-370 D7, GH #317):
                                                              `while` gates every rule
                                                              the action registers —
                                                              where it is false the input
                                                              parses as though the action
                                                              did not exist. Story tier
                                                              only: in a grammar file it
                                                              is analysis.grammar-file-
                                                              behavior *)
action-line    = "grammar" NL >>> { pattern-line }
               | "the" WORD "must" "be" WORD NL            (* scope constraint (no colon) *)
               | "the" WORD "takes" "the" "rest" "of" "the" "line" NL
                                                           (* greedy slot → :slot... (D10) *)
               | "the" WORD "is" ( "an" | "a" ) WORD NL    (* typed slot — instrument | topic (D11) *)
               | "directions" NL >>> { WORD { "or" WORD } NL }
                                                           (* direction map bound to the `direction`
                                                              slot; per-action vocabulary (D12) *)
               | must-line                                 (* D6 requirement (has colon) *)
               | score-line
               | "refuse" "without" WORD ":" phrase-key NL
               | "refuse" "when" condition ":" phrase-key NL
               | "otherwise" "refuse" phrase-key NL        (* dispatch miss *)
               | "phrases" LOCALE NL >>> { phrase-entry }
               | statement ;
pattern-line   = pattern [ "→" token { token } ] NL
                 { "means" WORD WORD NL } ;                 (* ADR-267 D1: one slot production
                                                              (pattern-elem); → = cardinality;
                                                              indented "means <key> <value>" lines
                                                              = static defaults for THIS pattern (D12) *)

(* ---- ADR-270 author alteration model (2026-07-26) ---------------------- *)

extend-action  = "extend" "action" WORD NL action-line* ;  (* dedent-terminated. Grammar
                                                              surfaces only: behavior lines
                                                              (must-line, score-line, refuse,
                                                              otherwise, phrases, statements)
                                                              parse but are analyzer errors
                                                              (analysis.alteration-behavior).
                                                              The target action resolves
                                                              story-first, else the stdlib
                                                              id set — unknown name is a
                                                              load error with a suggestion *)
remove-from-action
               = "remove" "from" "action" WORD NL
                 >>> { pattern NL } ;                       (* shapes only — a "means" line or
                                                              "→" cardinality here is
                                                              analysis.removal-shape; an
                                                              unmatched shape is a load
                                                              error, never a silent no-op *)

define-sequence= "define" "sequence" WORD { WORD } NL
                 { sequence-step } "end" "sequence" NL ;

(* ---- ADR-264 numeric counters ------------------------------------------ *)

define-counter = "define" "counter" WORD [ "starts" NUMBER ]
                          [ "between" NUMBER "and" NUMBER ] NL ;
                 (* a story-global counter; `starts`/bounds optional *)

(* ---- ADR-119 state-machine depth (spelling A per ADR-215; core, no `use` line, ADR-377) ---- *)

define-machine = "define" "machine" WORD { WORD } NL
                 >>> { "role" WORD "is" name NL
                     | "starts" WORD NL
                     | machine-state }
                 "end" "machine" NL ;
machine-state  = "state" WORD [ "," "terminal" ] NL
                 >>> { machine-when | machine-on } ;
machine-when   = "when" machine-trigger [ "while" condition ] ":" WORD NL ;
machine-trigger= "event" phrase-key                        (* event trigger *)
               | WORD name                                 (* action on a role/entity:
                                                              `turning the winch` — a
                                                              declared role name lowers
                                                              to the $role binding *)
               | WORD                                      (* bare word: a declared
                                                              condition/story state wins,
                                                              else an action gerund *)
               | condition ;
machine-on     = ( "on" "enter" | "on" "exit" ) NL
                 >>> { statement } "end" "on" NL ;
                                                           (* machines are story-owned:
                                                              `it` in a body/trigger is a
                                                              compile error *)

(* ---- ADR-216 declared assets + custom channels ------------------------- *)

define-asset   = "define" ( "sound" | "image" | "music" )
                 WORD "from" STRING NL                     (* a DATA reference, not code —
                                                              kept when the hatches were
                                                              removed (ADR-361 D1) *)
               | "define" "sound" WORD NL ;                (* ADR-374 D6: a sound in the
                                                              world only, played to no
                                                              speaker; an ambient bed
                                                              still needs a file
                                                              (analysis.asset-no-file) *)

define-family-channel                                      (* ADR-241: a named ambient
                                                              bed / image layer; words
                                                              beyond the implied set
                                                              (`main` bed; background/
                                                              main/overlay layers) must
                                                              be declared — never-guess *)
             = "define" ( "ambient" | "layer" ) WORD NL ;

define-channel = "define" "channel" WORD NL                (* spelling A; ADR-253 *)
                 >>> { "mode" ( "replace" | "append" | "event" ) NL
                     | "gated" "by" WORD NL                (* a client capability flag *)
                     | "return" channel-return "from" WORD NL
                       [ channel-record-body ] }           (* record members: ADR-300 D10 *)
                 "end" "channel" NL ;
channel-return = WORD | STRING | "phrase" WORD             (* field | "text (slot)" | phrase;
                                                              ADR-253 replaced `from event`
                                                              + `take` (a `take` line is now
                                                              parse.channel-take-removed). The
                                                              value renders by DOM-name, else
                                                              the generic panel. *)
               | "record" ;                                (* ADR-300 D10: a structured
                                                              value. Present only so an
                                                              author can DECLARE what the
                                                              platform already emits — a
                                                              channel's value may be a
                                                              record (ADR-300 D7; the
                                                              banner is one). Its members
                                                              follow as an indented block. *)
channel-record-body                                        (* ADR-300 D10; legal only after
                                                              `return record from <event>`.
                                                              Members project from THAT
                                                              event's payload — a record is
                                                              one event read as structure,
                                                              not several joined. An empty
                                                              body is analysis.channel-
                                                              record-empty; a duplicate
                                                              member name is analysis.
                                                              channel-record-duplicate. *)
             = >>> { channel-record-member }
               "end" "record" NL ;
channel-record-member                                      (* `list of` yields an array:
                                                              an array field passes through,
                                                              a single value becomes one
                                                              element, an absent field
                                                              becomes []. An absent scalar
                                                              member is OMITTED, so a
                                                              consumer can branch on
                                                              presence. Records do not nest
                                                              (parse.channel-record-nested). *)
             = WORD [ "list" "of" ] channel-return NL ;
define-topics  = "define" "topics" "for" name NL           (* ADR-239 D3 as amended:
                                                              the ask/tell topic table.
                                                              One block per entity
                                                              (analysis.duplicate-topics-
                                                              block); person-kind owners
                                                              only (analysis.topics-host);
                                                              at least one row
                                                              (parse.topics-empty) *)
                 >>> { topic-row }
                 "end" "topics" NL ;
topic-row      = "about" topic-key ":" ( statement         (* one-line response *)
                                       | NL >>> { statement } ) ;
                                                           (* indented statement body;
                                                              `it` = the owner; the
                                                              phrase declare-and-emit
                                                              prose sugar applies *)
topic-key      = name                                      (* entity tier — matched via
                                                              the platform's quiet
                                                              topicEntityId resolution *)
               | STRING { "," STRING } ;                   (* free-text tier: primary +
                                                              declared aliases (comma
                                                              list, David 2026-07-18).
                                                              Lookup is normalized whole-
                                                              topic equality — never
                                                              fuzzy (D4). Duplicates and
                                                              quoted-vs-entity-tier
                                                              collisions are compile
                                                              errors (analysis.duplicate-
                                                              topic / analysis.topic-
                                                              entity-collision) *)

define-manner  = "define" "manner" "for" name NL           (* ADR-320 D5 (frozen
                                                              2026-08-17): the delivery
                                                              layer — beats and voice
                                                              color any phrase lacking a
                                                              more specific authored
                                                              variant. One block per
                                                              person (analysis.duplicate-
                                                              manner-block /
                                                              analysis.manner-host); at
                                                              least one row
                                                              (parse.manner-empty).
                                                              Rows need NOT be mutually
                                                              exclusive — layering is the
                                                              scene runtime's *)
                 >>> { manner-row }
                 "end" "manner" NL ;
manner-row     = "when" condition ":" NL
                 >>> { "beat" STRING NL
                     | "voice" WORD NL } ;                 (* beats rotate at runtime,
                                                              never back-to-back; voice
                                                              is ONE word, open
                                                              vocabulary, at most one
                                                              per row (analysis.manner-
                                                              voice-duplicate) *)

define-greetings = "define" "greetings" "for" name NL      (* ADR-320 D4 (spelling frozen
                                                              2026-08-17): scene boundary
                                                              rows. Person-kind owners
                                                              (analysis.greetings-host);
                                                              one block per entity; a
                                                              boundary answers in one
                                                              place (analysis.duplicate-
                                                              greeting) *)
                   >>> { greeting-row }
                   "end" "greetings" NL ;
greeting-row   = greeting-head ":" ( statement            (* one-line response *)
                                   | NL >>> { statement } ) ;
greeting-head  = "first" "time"
               | "on" "return" [ "," absence-words ]      (* absence ages off the pair's
                                                              last scene close, through
                                                              the character clock seam *)
               | "asked" repetition-words                 (* scene visits in this
                                                              context; runtime owns the
                                                              counting *)
               | "on" "leaving" ;
absence-words  = "again" "so" "soon"
               | "after" "a" "while"
               | "after" "days" ;                          (* frozen 2026-08-17 *)
repetition-words = "once" | "again" | "many" "times" ;     (* frozen 2026-08-17 *)

define-exchange = "define" "exchange" WORD "for" name      (* ADR-320 D4 (frozen
                                                              2026-08-17): a named
                                                              exchange point — the
                                                              response set overlaying the
                                                              owner's topic table while
                                                              open. Responses only: the
                                                              opening line lives in the
                                                              calling row's `then asks`.
                                                              Person-kind owners
                                                              (analysis.exchange-host);
                                                              one definition per
                                                              (owner, key) (analysis.
                                                              duplicate-exchange); at
                                                              least one row (parse.
                                                              exchange-empty). No
                                                              `otherwise` row — a miss
                                                              falls through to the topic
                                                              table (D16) *)
                  [ "," strength-word ] NL                 (* D10: unset = the runtime
                                                              derives strength from
                                                              intent *)
                  >>> { exchange-row }
                  "end" "exchange" NL ;
exchange-row   = exchange-head ":" ( statement             (* one-line response *)
                                   | NL >>> { statement } ) ;
exchange-head  = "answer" topic-key                        (* what the responder says —
                                                              the topic-key grammar
                                                              reused whole; duplicates
                                                              and cross-tier collisions
                                                              gate (analysis.duplicate-
                                                              answer / analysis.answer-
                                                              entity-collision) *)
               | "on" "silence"                            (* the responder says nothing
                                                              — rendered like any
                                                              response (D8) *)
               | "on" WORD ;                               (* what the responder does —
                                                              an act/event word from the
                                                              existing event-verb
                                                              register *)
strength-word  = "passive" | "assertive" | "blocking" ;    (* frozen 2026-08-17; spelled
                                                              exactly as @sharpee/
                                                              character's
                                                              ConversationStrength *)

define-initiative = "define" "initiative" "for" name NL    (* ADR-320 D7 (frozen
                                                              2026-08-17): authored
                                                              occasion rows that force —
                                                              or, via `hold their
                                                              tongue`, suppress — a
                                                              seizure. Person-kind owners
                                                              (analysis.initiative-host);
                                                              one block per entity
                                                              (analysis.duplicate-
                                                              initiative-block); at least
                                                              one row (parse.initiative-
                                                              empty). Rows need not be
                                                              mutually exclusive —
                                                              most-specific-wins is the
                                                              scene runtime's *)
                    >>> { initiative-row }
                    "end" "initiative" NL ;
initiative-row = occasion-head [ "," "when" condition ]    (* refinement composes like
                                                              `on return, after days` *)
                 ":" ( statement | NL >>> { statement } ) ;
occasion-head  = "on" "an" "open" "floor"                  (* the author-addressable
                                                              SceneOccasion kinds;
                                                              goal-step is deliberately
                                                              unsurfaced — the goal
                                                              machinery owns it *)
               | "on" "silence"
               | "when" "the" "subject" "changes"          (* the Phase 3 threading
                                                              condition reused as a
                                                              head *)
               | "on" WORD ;                               (* witnessed act/event — the
                                                              event-verb register *)

define-conversation = "define" "conversation" WORD "for" name (* ADR-320 D14 (frozen
                                                              2026-08-17): a conversation
                                                              thread — an author-scripted
                                                              subject carried beat by
                                                              beat to a conclusion,
                                                              across sittings. Person-
                                                              kind owners (analysis.
                                                              conversation-host); one
                                                              definition per (owner, key)
                                                              (analysis.duplicate-
                                                              conversation); at least one
                                                              beat (parse.conversation-
                                                              no-beat); exactly one
                                                              conclusion (parse.
                                                              conversation-no-conclusion /
                                                              parse.conversation-
                                                              duplicate-row) *)
                      [ "," strength-word ] NL             (* governs off-thread
                                                              transitions: blocking =
                                                              single-topic completion;
                                                              unset = intent derives *)
                      >>> { conversation-row }
                      "end" "conversation" NL ;
conversation-row = "about" topic-key NL                    (* the thread's topic filter —
                                                              the topic-key grammar
                                                              reused; at most one
                                                              (parse.conversation-
                                                              duplicate-row) *)
                 | "opens" "when" condition NL             (* the NPC-opened entry gate;
                                                              at most one *)
                 | "beat" [ "," "when" condition ] ":"     (* 1..n ordered beats; the
                                                              hold-gate composes like the
                                                              initiative refinement *)
                   ( statement | NL >>> { statement } )
                 | "on" transition-word ":"                (* at most one of each *)
                   ( statement | NL >>> { statement } )
                 | "conclusion" ":"                        (* beat n — fires once; the
                                                              thread is then CONCLUDED
                                                              and `<key> is concluded`
                                                              holds *)
                   ( statement | NL >>> { statement } ) ;
transition-word = "parting" | "resuming" | "refusing" ;    (* frozen 2026-08-17 *)

define-pronouns = "define" "pronouns" WORD NL              (* ADR-242 D7 (ratchet H3):
                                                              a named pronoun set — five
                                                              named case rows, order
                                                              free, all required
                                                              (analysis.pronoun-set-rows /
                                                              -duplicate-row); a name
                                                              shadowing he|she|it|they is
                                                              analysis.pronoun-set-
                                                              shadows. Forms are DATA
                                                              (ir.pronounSets) — the
                                                              loader registers them into
                                                              the language provider *)
                  >>> { PRONOUN-CASE WORD NL }
                  "end" "pronouns" NL ;
PRONOUN-CASE    = "subject" | "object" | "possessive"
                | "possessive-pronoun" | "reflexive" ;

sequence-step  = step-anchor NL >>> { statement } ;
step-anchor    = "at" "turn" NUMBER                        (* absolute from story start *)
               | NUMBER "turns" "later"                    (* relative to previous step *)
               | "when" name "becomes" ( WORD | "under" "way" )
               | "when" name "comes" "into" "sight" ;      (* state anchor, D10; `under
                                                              way` is a vehicle's own
                                                              transition (ADR-366 D5e),
                                                              legal on a vehicle whose
                                                              type moves over turns.
                                                              `comes into sight` (ADR-376
                                                              D7, under `use expanses`):
                                                              the first step that brings
                                                              the thing within the
                                                              looker's sight, carried as
                                                              the state `in sight` *)


(* ---- must requirements (D6) -------------------------------------------- *)
(* Legal as a define-action line AND as a body statement (never in `after`).
   The line must OPEN with lowercase `the`/`it`/`its` so capitalized prose
   stays prose. `must not …` and `must be no <name>` are parse errors —
   prohibitions use `refuse when <condition>: <key>`. *)

must-line    = must-subject "must" infinitive ":" phrase-key NL ;
must-subject = value-expr ;
infinitive   = "be" ( ( "a" | "an" ) WORD { WORD }         (* is-a *)
                    | "in" name                            (* is-in *)
                    | "any" WORD                           (* membership over a named
                                                              open condition *)
                    | value-expr )                         (* is *)
             | ( "have" | "hold" | "wear" ) name           (* has/holds/wears *)
             | ( "see" | "reach" ) name ;                  (* can see/reach *)


(* ---- Statements --------------------------------------------------------- *)

statement    = "refuse" phrase-key { param } NL            (* not in `after` bodies *)
             | "refuse" "when" condition ":" phrase-key NL (* prohibition; not in `after` *)
             | must-line                                   (* not in `after` *)
             | "phrase" phrase-key { param } [ stmt-when ] NL [ inline-prose ]
             | "emit" phrase-key { phrase-key }
               [ "with" emit-field { "and" emit-field } ]
               [ stmt-when ] NL                            (* ADR-216 payloaded emit:
                                                              event segments are dotted
                                                              keys (media.sound.play);
                                                              keys pass verbatim into
                                                              event.data *)
             | media-statement                             (* ADR-216 sugar, below *)
             | "set" value-expr "to" value-expr [ stmt-when ] NL
                                                           (* ADR-375 D4, D7, under `use
                                                              sailing`: `set the
                                                              <expanse>'s wind to
                                                              <DIRECTION | NUMBER degrees
                                                              | calm>` (parse.set-wind) and
                                                              `set the <vehicle>'s sails
                                                              to WORD` (analysis.sails-
                                                              unknown-setting) *)
                                                           (* a trait field, a region's
                                                              landing (ADR-325 D5), or
                                                              a tally's absolute value
                                                              (ADR-325 D4, clamped) *)
             | "change" "mood" "to" WORD [ stmt-when ] NL  (* ADR-310 D3: the clause
                                                              owner's mood; the word
                                                              is analyzer-resolved *)
             | "change" "feeling" "toward" name "to" disposition
               [ stmt-when ] NL                            (* ADR-310 D3: the owner's
                                                              disposition toward one
                                                              entity *)
             | "change" "the" "player" "to" name [ stmt-when ] NL
                                                           (* ADR-327 D9/D10: the role moves
                                                              to a named `playable` person
                                                              (analysis.player-target-not-
                                                              person / -not-playable). Read
                                                              twice by the loader: an
                                                              assignment inside the start
                                                              block, a switch request on any
                                                              turn after that *)
             | "change" name "to" WORD [ stmt-when ] NL    (* name may be `the story`
                                                              or any entity *)
             | "move" name ( "to" place | "here" | "offstage" )
               [ stmt-when ] NL                            (* ADR-325 D1/D2: `here` is
                                                              the player's location;
                                                              `offstage` is no location
                                                              — the entity keeps its
                                                              states and timers and is
                                                              reattached by a later
                                                              `move` (`remove` stays
                                                              terminal). A trailing
                                                              here/offstage ends the
                                                              name; elsewhere it is
                                                              part of it *)
             | "make" name ( "wear" | "take" "off" ) name
               [ stmt-when ] NL                            (* ADR-325 Amendment W1: a
                                                              put in the `move` family —
                                                              the garment goes on (moved
                                                              to the actor first if not
                                                              held; off another wearer
                                                              first) or comes off and
                                                              stays held. Nothing is
                                                              narrated. `the player` is
                                                              a legal actor; the garment
                                                              must be wearable and the
                                                              actor a person
                                                              (analysis.wear-not-wearable,
                                                              analysis.wear-actor-not-
                                                              person) *)
             | timer-verb value-expr
               [ "heading" ( DIRECTION | NUMBER "degrees" ) ]
               [ stmt-when ] NL                            (* ADR-375 D2: a bearing
                                                              0..359 under `use sailing`
                                                              on an open vehicle.
                                                              ADR-325 D3c: bare name in
                                                              the owner's block,
                                                              possessive elsewhere;
                                                              `stop music|ambient` is
                                                              the media statement.
                                                              ADR-366 D5f: `start` and
                                                              `stop` naming a vehicle
                                                              are its driving statements
                                                              (the analyzer resolves the
                                                              name: a timer, a vehicle,
                                                              else analysis.unknown-
                                                              timer); `heading` is legal
                                                              only on `start` of a
                                                              `compass` vehicle under
                                                              `drive: control`; a
                                                              statement outside the
                                                              type's row is analysis.
                                                              vehicle-statement-not-for-
                                                              movement *)
             | "send" name "to" ( name | NUMBER "," NUMBER )
               [ stmt-when ] NL                            (* ADR-366 D5d: a `flight`
                                                              vehicle under `drive:
                                                              control` to one of its
                                                              destinations (analysis.
                                                              not-a-destination). ADR-376
                                                              D3: an `open` vehicle to a
                                                              landmark of its expanse or
                                                              to `<x>, <y>` inside it
                                                              (analysis.coordinates-
                                                              outside-expanse); the pair
                                                              on any other type is
                                                              analysis.vehicle-statement-
                                                              not-for-movement *)
             | "kill" "the" "player" [ phrase-key ] [ stmt-when ] NL
               [ >>> prose-paragraph ]                     (* ADR-227; ADR-325 D3i: an
                                                              indented body in place of
                                                              the key, never both
                                                              (parse.kill-body) *)
             | name verb-words [ stmt-when ] NL            (* ADR-329 D1/D2: the acting
                                                              statement — a character
                                                              performs one action NOW
                                                              through the execution
                                                              entry. The first words
                                                              name a person (never `the
                                                              player`: analysis.act-
                                                              player-actor); the rest
                                                              match a standard or
                                                              story grammar shape by
                                                              verb lemma (analysis.act-
                                                              unknown-verb / act-slot-
                                                              shape). Legal in `after`,
                                                              `when`, `on every turn`,
                                                              and conversation rows —
                                                              not in an `on` intercept
                                                              (analysis.act-in-
                                                              intercept). Move PUTS;
                                                              acting DOES (D7) *)
             | "remove" name [ stmt-when ] NL              (* Z6: remove from play;
                                                              never the player *)
             | "award" { token } [ "," "once" ] [ stmt-when ] NL
             | ( "raise" | "lower" ) counter-ref "by" NUMBER
               [ stmt-when ] NL                            (* ADR-264 D2: additive
                                                              counter mutation, clamped *)
             | "win" [ WORD ] [ stmt-when ] NL
             | "lose" [ WORD ] [ stmt-when ] NL
             | "then" ( "asks" | "invites" ) WORD NL       (* ADR-320 D4/D8 (frozen
                                                              2026-08-17): open the named
                                                              exchange — same-owner
                                                              (analysis.then-target); the
                                                              word is carried as wire
                                                              data. Conversation rows
                                                              only (parse.then-context) *)
             | "deflect" "to" ( name | STRING ) NL         (* ADR-320 D8: redirect to a
                                                              row of the owner's OWN
                                                              topic table (analysis.
                                                              deflect-target); the
                                                              topic-key tiers. Conversation
                                                              rows only *)
             | "leave" NL                                  (* ADR-320 D8: exit the scene
                                                              — a movement move, world
                                                              legality consulted at
                                                              dispatch. Conversation rows
                                                              only *)
             | "hold" "their" "tongue" NL                  (* ADR-320 D7: suppress the
                                                              seizure — initiative rows
                                                              only (parse.hold-tongue-
                                                              context), and the row's
                                                              only statement (analysis.
                                                              hold-tongue-alone) *)
             | select-on | select-strategy | ordinal-block | each-block ;
stmt-when    = "when" condition ;                          (* statement-final suffix, D7:
                                                              legal on phrase, emit, change,
                                                              move, remove, award, win, lose,
                                                              set, kill, the timer verbs,
                                                              and the acting statement —
                                                              not on bare refuse *)
timer-verb   = "start" | "stop" | "restart" | "reset" | "interrupt" ;
                                                           (* ADR-325 D3c: start is a
                                                              no-op when running; stop
                                                              holds; restart = first
                                                              state and running; reset
                                                              = not started; interrupt
                                                              expires now and fires the
                                                              `when … expires` clause *)
place        = name                                        (* a room, an enterable, a
                                                              region with a landing *)
             | name "'s" "location" | "its" "location"    (* ADR-325 D1: the containing
                                                              room, always; a room's is
                                                              itself, a region's is its
                                                              landing; an offstage
                                                              owner refuses at run time *)
             | "a" "random" "adjacent" "room" ;            (* ADR-326 D1: one traversable
                                                              exit from the mover's
                                                              room, drawn at effect
                                                              time; a `move` destination
                                                              only (parse.adjacent-room-
                                                              placement) *)
verb-words   = WORD { WORD | name } ;                      (* ADR-329 D2: `takes the sword`,
                                                              `gives the sword to Alex`,
                                                              `goes east` — the verb in
                                                              either inflection, then the
                                                              shape's slots as names or a
                                                              direction word *)
phrase-key   = WORD ;                                      (* single kebab word; a "." is
                                                              parse.dotted-key (ADR-254/256) *)
param        = "with" WORD { WORD } "=" value-expr ;

(* ---- ADR-216 emit payload + media sugar -------------------------------- *)

emit-field   = WORD { WORD } emit-value ;                  (* key words, then the value *)
emit-value   = NUMBER | STRING                             (* literals *)
             | "[" [ emit-value { "," emit-value } ] "]"   (* arrays *)
             | "{" [ emit-field { "," emit-field } ] "}"   (* nested objects *)
             | value-expr ;                                (* world-state reads; entity
                                                              refs → world ids;
                                                              true/false → booleans;
                                                              unquoted words resolve as
                                                              words always do — plain
                                                              strings are QUOTED *)

media-statement                                            (* each lowers at compile
                                                              onto a payloaded media.*
                                                              emit; stmt-when composes *)
             = "play" "sound" WORD [ stmt-when ] NL        (* ADR-374 D6: its own IR
                                                              statement — the cue when
                                                              the sound has a file, and
                                                              always a sound in the world
                                                              from the owner's room,
                                                              heard by listeners *)
             | "play" "music" WORD [ "looping" ] [ stmt-when ] NL
             | "play" "ambient" WORD [ "in" WORD ]
               [ stmt-when ] NL                            (* plays a SOUND asset; the
                                                              channel word names a bed —
                                                              default `main` (ADR-241) *)
             | "stop" "music" [ stmt-when ] NL
             | "stop" "ambient" [ "in" WORD ]
               [ stmt-when ] NL                            (* bare form stops the
                                                              default bed only *)
             | "show" "image" WORD [ "in" WORD ] [ stmt-when ] NL
             | "hide" "image" [ stmt-when ] NL
             | "transition" WORD [ stmt-when ] NL          (* → media.transition kind *)
             | "clear" [ stmt-when ] NL ;
                                                           (* asset WORDs must name a
                                                              `define sound|image|music`
                                                              declaration — typo-checked
                                                              with suggestions; kind
                                                              mismatches gate *)
select-on    = "select" "on" value-expr NL
               >>> { "when" WORD NL >>> { statement } } "end" "select" NL ;
select-strategy = "select" STRATEGY NL
               >>> { statement } { "or" NL >>> { statement } } "end" "select" NL ;
ordinal-block = ORDINAL "time" NL >>> { statement } ;
ORDINAL      = "first" | "second" | "third" | "fourth" | "fifth"
             | "sixth" | "seventh" | "eighth" | "ninth" | "tenth" ;
each-block   = "each" WORD NL                              (* E3: iteration over a named
                                                              open condition *)
               >>> { statement } "end" "each" NL ;
               (* legal exactly where statements are; never top-level;
                  nesting legal; `the match` binds innermost *)


(* ---- Conditions (closed selector grammar) ------------------------------- *)
(* Precedence lowest → highest: or, and, not. *)

condition    = and-expr { "or" and-expr } ;
and-expr     = unary { "and" unary } ;
unary        = "not" unary
             | "(" condition ")"
             | "one" "chance" "in" NUMBER
             | "client" "has" WORD                         (* ADR-216: live client
                                                              capability flag (sound,
                                                              split-pane, …); `client`
                                                              reserved in subject
                                                              position; closed flag set *)
             | ( "any" | "no" ) WORD                       (* E1/E2 quantifiers: only when
                                                              the WORD stands alone *)
             | "the" "subject" "changes"                   (* ADR-320 D9 (frozen
                                                              2026-08-17): the scene
                                                              noticed a live thread
                                                              abandoned; all three words
                                                              required *)
             | "asked" repetition-words                    (* ADR-320 D4: the enclosing
                                                              row's per-pair ask count
                                                              read as a word *)
             | ( "during" | "before" | "after" ) WORD      (* ADR-330 D5: the current
                                                              chapter is / has not
                                                              reached / has passed the
                                                              named `define chapters`
                                                              row (analysis.unknown-
                                                              chapter; needs `use
                                                              chapters`); the name
                                                              stands alone, before a
                                                              connective or the end *)
             | WORD                                        (* bare => named-condition or
                                                              state ref, only when a
                                                              connective or end-of-condition
                                                              follows *)
             | value-expr predicate ;
predicate    = "is" [ "not" ] ( ( "a" | "an" ) WORD { WORD }   (* is-a *)
                              | "in" name                      (* is-in *)
                              | "here"                         (* Z4 deictic: subject shares
                                                                  the player's location;
                                                                  entity subjects only *)
                              | recency-word                   (* ADR-320 D6 (frozen
                                                                  2026-08-17): the subject
                                                                  is a TOPIC; triggers only
                                                                  when the word stands
                                                                  alone (end of condition
                                                                  or a connective) *)
                              | "concluded"                    (* ADR-320 D14 (frozen
                                                                  2026-08-17): the subject
                                                                  is a THREAD KEY; same
                                                                  standalone rule as the
                                                                  recency words *)
                              | "under" "way"                  (* ADR-366 D5e: the subject
                                                                  is a VEHICLE whose type
                                                                  moves over turns; one
                                                                  fixed phrase *)
                              | "in" "sight"
                              | "close" "by"
                              | "in" "the" "distance"
                              | "on" "the" "horizon"           (* ADR-376 D7, under `use
                                                                  expanses`: the subject is
                                                                  seen from where the
                                                                  player looks, in sight or
                                                                  in one band; each phrase
                                                                  stands alone (the recency
                                                                  rule), so `is in <room>`
                                                                  keeps its reading *)
                              | "within" NUMBER "of"
                                ( name | NUMBER "," NUMBER )   (* ADR-376 D7: an OPEN
                                                                  vehicle's distance from a
                                                                  landmark of its expanse
                                                                  or from coordinates
                                                                  (analysis.not-a-
                                                                  destination, coordinates-
                                                                  outside-expanse;
                                                                  parse.within) *)
                              | "at" name                      (* ADR-366 D5: the vehicle
                                                                  is at the named stop,
                                                                  room or destination;
                                                                  `at least`/`at most`
                                                                  stay the comparison *)
                              | "in" "irons"                   (* ADR-375 D5, under `use
                                                                  sailing`: a sailing
                                                                  vehicle lies still in a
                                                                  `stopped` band *)
                              | "heading" ( DIRECTION
                                          | NUMBER "degrees" )   (* ADR-366 D5c: a compass
                                                                  or open vehicle's heading;
                                                                  a bearing under `use
                                                                  sailing` (ADR-375 D2).
                                                                  ADR-366 D5c: a compass
                                                                  vehicle's heading.
                                                                  A non-vehicle subject
                                                                  on any of the three is
                                                                  analysis.not-a-vehicle;
                                                                  a vehicle whose type
                                                                  lacks the condition is
                                                                  analysis.vehicle-
                                                                  condition-not-for-
                                                                  movement *)
                              | word-compare NUMBER            (* ADR-264 D3 word form *)
                              | value-expr )                   (* is *)
             | "are" [ "not" ] WORD                           (* ADR-375 D7: the subject is
                                                                  `<vehicle>'s sails`; the
                                                                  word one of its settings
                                                                  (parse.sails-setting;
                                                                  analysis.sails-unknown-
                                                                  setting) *)
             | "has" [ "not" ] ( "started" | "expired" )      (* ADR-325 D3d: a TIMER's
                                                                  lifecycle, only when the
                                                                  word stands alone; `is`
                                                                  reads its named turn;
                                                                  `is expired` is analysis.
                                                                  timer-is-expired *)
             | ( "has" | "holds" | "wears" ) name
             | "feels" disposition [ "toward" ] name           (* ADR-310 D13: the subject's
                                                                  disposition toward an
                                                                  entity *)
             | "knows" name                                   (* ADR-310 D13: the subject
                                                                  holds the topic — a
                                                                  `knows` line, propagation,
                                                                  or a witnessed act
                                                                  (ADR-318 D12a) *)
             | "was" "discussed"                              (* ADR-320 D9: the subject
                                                                  is a TOPIC; per-pair
                                                                  discussed-ness *)
             | "can" ( "see" | "reach" ) name
             | compare-op NUMBER ;                            (* ADR-264 D3 symbolic form *)
recency-word = "fresh" | "recent" | "stale" ;                 (* frozen 2026-08-17 *)
word-compare = "at" "least" | "more" "than" | "at" "most" | "less" "than" ;
compare-op   = ">=" | ">" | "<=" | "<" ;                      (* ADR-264: lexed as one token *)
counter-ref  = WORD | "its" WORD | name "'s" WORD ;           (* ADR-264: a counter, story-global
                                                                 (bare) or per-entity (possessive) *)

value-expr   = NUMBER | STRING
             | "the" "match"                               (* E3 binder, standalone only —
                                                              `the match box` stays a name *)
             | "its" field-words                           (* possessive on `it` *)
             | name [ "'s" field-words ]                   (* the player's location *)
             | WORD { WORD } ;                             (* bare words *)
name         = [ ARTICLE ] WORD { WORD } [ NUMBER ] ;      (* a trailing number names
                                                              a numbered room: `the Maze
                                                              61` (ADR-360 D1) *)
ARTICLE      = "the" | "a" | "an" ;

(* Noun phrases stop at: is has holds wears can feels knows was and or then to while with.
   State adjectives (open, closed, locked, unlocked, on, off, worn, lit) are
   the plain `is <value>` predicate — a closed analyzer catalog, not syntax. *)
