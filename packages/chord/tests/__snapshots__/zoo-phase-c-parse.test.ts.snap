            "line": 142,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A sturdy metal gate with a "STAFF ONLY" sign.",
            },
          ],
        },
        "staff-gate.gate-look": {
          "span": {
            "column": 7,
            "endColumn": 52,
            "endLine": 146,
            "line": 146,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A sturdy metal gate with a "STAFF ONLY" sign.",
            },
          ],
        },
