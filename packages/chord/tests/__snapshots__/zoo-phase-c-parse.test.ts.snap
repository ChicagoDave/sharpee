      "id": "friendly-zoo",
      "storyVersion": "0.0.2-phase-c-sketch",
      "testers": [],
      "themes": [],
    },
    "title": "Friendly Zoo",
  },
  "phrasebooks": [],
  "phrases": {
    "defaultLocale": "en-US",
    "locales": {
      "en-US": {
        "alex.description": {
          "span": {
            "column": 3,
            "endColumn": 39,
            "endLine": 127,
            "line": 127,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Just an ordinary visitor to the zoo.",
            },
          ],
        },
        "already-fed": {
          "span": {
            "column": 5,
            "endColumn": 59,
            "endLine": 464,
            "line": 463,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You've already fed them. They look contentedly full.",
            },
          ],
        },
        "aviary-plaque.description": {
          "span": {
            "column": 3,
            "endColumn": 57,
            "endLine": 312,
            "line": 312,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A colorful information board near the aviary entrance.",
            },
          ],
        },
        "aviary-plaque.plaque-text": {
          "span": {
            "column": 7,
            "endColumn": 74,
            "endLine": 320,
            "line": 316,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "WELCOME TO THE AVIARY — Home to over 30 species!

TOCO TOUCAN — Its bill weighs less than a smartphone.

SCARLET MACAW — Can live over 75 years. Our oldest, Captain, is 42.",
            },
          ],
        },
        "aviary.description": {
          "span": {
            "column": 3,
            "endColumn": 8,
            "endLine": 57,
            "line": 53,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You step inside a soaring mesh dome. Brilliantly colored parrots chatter from rope perches, and a toucan eyes you curiously from a branch overhead. A small waterfall splashes into a stone basin. An info plaque hangs near the entrance. The gift shop is to the west. The main path is back to the east.",
            },
          ],
        },
        "aviary.parrot-nods": {
          "span": {
            "column": 7,
            "endColumn": 27,
            "endLine": 71,
            "line": 70,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The parrot glances at you and nods, as if recognizing a fellow after-hours regular.",
            },
          ],
        },
        "aviary.parrot-notices": {
          "span": {
            "column": 7,
            "endColumn": 66,
            "endLine": 65,
            "line": 65,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The parrot ruffles its feathers and eyes you with interest.",
            },
          ],
        },
        "backpack.description": {
          "span": {
            "column": 3,
            "endColumn": 31,
            "endLine": 367,
            "line": 367,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A small red canvas backpack.",
            },
          ],
        },
        "bag-of-animal-feed.description": {
          "span": {
            "column": 3,
            "endColumn": 62,
            "endLine": 374,
            "line": 374,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A small brown paper bag filled with dried corn and pellets.",
            },
          ],
        },
        "barn-owl.description": {
          "span": {
            "column": 3,
            "endColumn": 55,
            "endLine": 240,
            "line": 240,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "An enormous barn owl with a heart-shaped white face.",
            },
          ],
        },
        "bleating": {
          "span": {
            "column": 5,
            "endColumn": 19,
            "endLine": 493,
            "line": 491,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The pygmy goats are bleating loudly and headbutting the fence. They seem very hungry!",
            },
          ],
        },
        "brochure-text": {
          "span": {
            "column": 1,
            "endColumn": 11,
            "endLine": 751,
            "line": 741,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "WILLOWBROOK FAMILY ZOO — Your Guide

EXHIBITS:
  Petting Zoo — East from Main Path
  Aviary — West from Main Path
  Gift Shop — West from Aviary
  Nocturnal Animals — Staff Area

"Where every visit is a wild adventure!"",
            },
          ],
          "verbatim": true,
        },
        "bush-babies.description": {
          "span": {
            "column": 3,
            "endColumn": 52,
            "endLine": 233,
            "line": 233,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Two bush babies with impossibly large round eyes.",
            },
          ],
        },
        "cant-pet": {
          "span": {
            "column": 5,
            "endColumn": 26,
            "endLine": 510,
            "line": 509,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You can't pet that.",
            },
          ],
        },
        "cork-board.description": {
          "span": {
            "column": 3,
            "endColumn": 48,
            "endLine": 289,
            "line": 288,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A cork board with staff schedules. A note in red marker: "DON'T FORGET: nocturnal exhibit lights need new batteries!"",
            },
          ],
        },
        "direction-signs.description": {
          "span": {
            "column": 3,
            "endColumn": 64,
            "endLine": 177,
            "line": 177,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Arrow signs: PETTING ZOO (east), AVIARY (west), EXIT (north).",
            },
          ],
        },
        "disposable-camera.description": {
          "span": {
            "column": 3,
            "endColumn": 76,
            "endLine": 442,
            "line": 442,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A cheap yellow disposable camera with "ZOO MEMORIES" printed on the side.",
            },
          ],
        },
        "enamel-pins.description": {
          "span": {
            "column": 3,
            "endColumn": 47,
            "endLine": 281,
            "line": 280,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A spinning rack of enamel pins: parrots, pygmy goats, a grinning snake. Every one of them costs more than it should.",
            },
          ],
        },
        "fed": {
          "span": {
            "column": 5,
            "endColumn": 58,
            "endLine": 466,
            "line": 465,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You offer some feed. The animal eats it gratefully.",
            },
          ],
        },
        "feed-dispenser.description": {
          "span": {
            "column": 3,
            "endColumn": 14,
            "endLine": 410,
            "line": 409,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A coin-operated feed dispenser mounted on a wooden post. Sign: "FREE — Just Turn!"",
            },
          ],
        },
        "flashlight.description": {
          "span": {
            "column": 3,
            "endColumn": 34,
            "endLine": 426,
            "line": 426,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A heavy-duty yellow flashlight.",
            },
          ],
        },
        "flower-beds.description": {
          "span": {
            "column": 3,
            "endColumn": 39,
            "endLine": 184,
            "line": 184,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Tidy beds of marigolds and petunias.",
            },
          ],
        },
        "gift-shop.description": {
          "span": {
            "column": 3,
            "endColumn": 55,
            "endLine": 111,
            "line": 109,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A small zoo gift shop crammed with stuffed animals and postcards. A large souvenir penny press machine stands near the door. A disposable camera sits on the counter. The aviary is back to the east.",
            },
          ],
        },
        "hay-bale.description": {
          "span": {
            "column": 3,
            "endColumn": 36,
            "endLine": 191,
            "line": 191,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A large round bale of golden hay.",
            },
          ],
        },
        "info-plaque.description": {
          "span": {
            "column": 3,
            "endColumn": 69,
            "endLine": 296,
            "line": 296,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A brass plaque mounted on a wooden post near the petting zoo gate.",
            },
          ],
        },
        "info-plaque.plaque-text": {
          "span": {
            "column": 7,
            "endColumn": 41,
            "endLine": 304,
            "line": 300,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "PYGMY GOATS — These Nigerian Dwarf goats are gentle, curious, and always hungry.

HOLLAND LOP RABBITS — Known for their floppy ears. Our pair, Biscuit and Marmalade, were born here in 2023.",
            },
          ],
        },
        "iron-fence.description": {
          "span": {
            "column": 3,
            "endColumn": 53,
            "endLine": 170,
            "line": 170,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A tall wrought-iron fence with animal silhouettes.",
            },
          ],
        },
        "juice-box.description": {
          "span": {
            "column": 3,
            "endColumn": 56,
            "endLine": 402,
            "line": 402,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A small juice box with a picture of a happy elephant.",
            },
          ],
        },
        "lunchbox.description": {
          "span": {
            "column": 3,
            "endColumn": 62,
            "endLine": 395,
            "line": 395,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A dented metal lunchbox decorated with cartoon zoo animals.",
            },
          ],
        },
        "main-path.description": {
          "span": {
            "column": 3,
            "endColumn": 56,
            "endLine": 32,
            "line": 29,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A wide gravel path winds through the heart of the zoo. Colorful direction signs point every which way. A park bench sits beside the path. To the east, the petting zoo. To the west, the aviary. A staff gate blocks the path to the south. The entrance is back to the north.",
            },
          ],
        },
        "metal-shelves.description": {
          "span": {
            "column": 3,
            "endColumn": 57,
            "endLine": 219,
            "line": 219,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Industrial metal shelving units stacked with supplies.",
            },
          ],
        },
        "no-camera": {
          "span": {
            "column": 5,
            "endColumn": 61,
            "endLine": 535,
            "line": 534,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You don't have a camera. There's one in the gift shop.",
            },
          ],
        },
        "no-feed": {
          "span": {
            "column": 5,
            "endColumn": 38,
            "endLine": 462,
            "line": 461,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You don't have any animal feed.",
            },
          ],
        },
        "nocturnal-animals-exhibit.description": {
          "span": {
            "column": 3,
            "endColumn": 44,
            "endLine": 98,
            "line": 95,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A cool, dimly lit cavern designed to simulate nighttime. Glass enclosures line both walls with soft red lights. You can see sugar gliders, bush babies, and a barn owl. A warning sign is posted near the entrance. The exit leads back north to the supply room.",
            },
          ],
        },
        "not-an-animal": {
          "span": {
            "column": 5,
            "endColumn": 41,
            "endLine": 521,
            "line": 520,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "That's not something you can feed.",
            },
          ],
        },
        "park-bench.description": {
          "span": {
            "column": 3,
            "endColumn": 44,
            "endLine": 388,
            "line": 388,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A sturdy park bench painted forest green.",
            },
          ],
        },
        "parrot-candor": {
          "span": {
            "column": 1,
            "endColumn": 11,
            "endLine": 739,
            "line": 724,
          },
          "strategy": "randomly",
          "variants": [
            {
              "markers": [],
              "text": "Finally, they're gone. Do you know how exhausting it is to say "Polly wants a cracker" eight hours a day?",
            },
            {
              "markers": [],
              "text": "Between you and me, the toucan is a complete diva. Won't shut up about its bill.",
            },
            {
              "markers": [],
              "text": "I have a degree in ornithology, you know. Well, I would, if birds could enroll.",
            },
            {
              "markers": [],
              "text": "The gift shop markup is criminal. Three dollars for a postcard? In this economy?",
            },
            {
              "markers": [],
              "text": "You seem alright. Most visitors just want selfies. At least you're still here.",
            },
          ],
        },
        "parrot-chatter": {
          "span": {
            "column": 1,
            "endColumn": 11,
            "endLine": 722,
            "line": 712,
          },
          "strategy": "randomly",
          "variants": [
            {
              "markers": [],
              "text": "Polly wants a cracker!",
            },
            {
              "markers": [],
              "text": "SQUAWK! Pretty bird! Pretty bird!",
            },
            {
              "markers": [],
              "text": "Pieces of eight! Pieces of eight!",
            },
            {
              "markers": [],
              "text": "Who's a good bird? WHO'S A GOOD BIRD?",
            },
            {
              "markers": [],
              "text": "BAWK! Welcome to the zoo!",
            },
          ],
        },
        "parrot.confession": {
          "span": {
            "column": 7,
            "endColumn": 25,
            "endLine": 595,
            "line": 591,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The parrot clears its throat — actually clears its throat — and fixes you with a knowing look. "Right then. Now that the performative squawking is over, let me tell you something: that toucan? Complete fraud. Can't even crack a nut properly. And don't get me started on the gift shop markup."",
            },
          ],
        },
        "parrot.description": {
          "span": {
            "column": 3,
            "endColumn": 35,
            "endLine": 572,
            "line": 571,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A magnificent scarlet macaw perched on a rope. It tilts its head and watches you with one bright eye.",
            },
          ],
        },
        "parrot.parrot-look": {
          "span": {
            "column": 7,
            "endColumn": 22,
            "endLine": 585,
            "line": 582,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [
                "flavor",
                "aside",
              ],
              "text": "A magnificent scarlet macaw perched on a rope. It tilts its head and watches you with one bright eye.

{flavor}{aside}",
            },
          ],
        },
        "parrot.petted": {
          "span": {
            "column": 3,
            "endColumn": 43,
            "endLine": 576,
            "line": 574,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You reach toward the parrot. CHOMP! It nips your finger with its beak. "NO TOUCHING!" it squawks indignantly.",
            },
          ],
        },
        "parrot.presence": {
          "span": {
            "column": 3,
            "endColumn": 62,
            "endLine": 578,
            "line": 577,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A scarlet macaw watches you with one bright, knowing eye.",
            },
          ],
        },
        "parrots.description": {
          "span": {
            "column": 3,
            "endColumn": 62,
            "endLine": 672,
            "line": 672,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A raucous flock of scarlet macaws and grey African parrots.",
            },
          ],
        },
        "petted": {
          "span": {
            "column": 5,
            "endColumn": 44,
            "endLine": 447,
            "line": 446,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You pet the animal. It seems pleased.",
            },
          ],
        },
        "petting-zoo.description": {
          "span": {
            "column": 3,
            "endColumn": 37,
            "endLine": 41,
            "line": 39,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A cheerful open-air enclosure that smells of warm hay and fur. A feed dispenser is mounted on a post, and an info plaque is posted by the gate. The main path is back to the west.",
            },
          ],
        },
        "postcards.description": {
          "span": {
            "column": 3,
            "endColumn": 64,
            "endLine": 273,
            "line": 273,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A spinning rack of postcards showing the zoo's greatest hits.",
            },
          ],
        },
        "pygmy-goats.confession": {
          "span": {
            "column": 7,
            "endColumn": 56,
            "endLine": 630,
            "line": 627,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Now that the keeper is gone, the goats exchange glances. The largest one turns to you and bleats in a very deliberate pattern. You could swear it sounds like: "Finally. Do you have any idea what it's like being called 'cute' six hundred times a day? We are MAJESTIC."",
            },
          ],
        },
        "pygmy-goats.description": {
          "span": {
            "column": 3,
            "endColumn": 42,
            "endLine": 608,
            "line": 608,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Three pygmy goats hoping you have food.",
            },
          ],
        },
        "pygmy-goats.fed": {
          "span": {
            "column": 3,
            "endColumn": 44,
            "endLine": 616,
            "line": 613,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You scatter some feed on the ground. The pygmy goats rush over, bleating excitedly, and devour the corn and pellets in seconds. The smallest goat looks up at you with big grateful eyes.",
            },
          ],
        },
        "pygmy-goats.petted": {
          "span": {
            "column": 3,
            "endColumn": 72,
            "endLine": 612,
            "line": 610,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You reach down and pet the nearest goat. It leans into your hand and bleats happily. The others crowd around, demanding equal attention.",
            },
          ],
        },
        "pygmy-goats.presence": {
          "span": {
            "column": 3,
            "endColumn": 76,
            "endLine": 618,
            "line": 617,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Three pygmy goats mill about hopefully, eyeing your pockets for snacks.",
            },
          ],
        },
        "rabbits.confession": {
          "span": {
            "column": 7,
            "endColumn": 21,
            "endLine": 664,
            "line": 660,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The rabbits stop mid-hop and look at each other. Biscuit twitches her nose disapprovingly. Marmalade thumps his foot twice. You get the distinct impression they're critiquing the quality of today's pellets. "Barely adequate," the thumping seems to say. "Last Tuesday's batch was far superior."",
            },
          ],
        },
        "rabbits.description": {
          "span": {
            "column": 3,
            "endColumn": 50,
            "endLine": 642,
            "line": 642,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A pair of Holland Lop rabbits with floppy ears.",
            },
          ],
        },
        "rabbits.fed": {
          "span": {
            "column": 3,
            "endColumn": 46,
            "endLine": 649,
            "line": 647,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You sprinkle some pellets near the rabbits. Biscuit and Marmalade hop over cautiously, then munch away happily.",
            },
          ],
        },
        "rabbits.petted": {
          "span": {
            "column": 3,
            "endColumn": 42,
            "endLine": 646,
            "line": 644,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You gently stroke one of the rabbits. Its fur is incredibly soft. It twitches its nose at you contentedly.",
            },
          ],
        },
        "rabbits.presence": {
          "span": {
            "column": 3,
            "endColumn": 75,
            "endLine": 651,
            "line": 650,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A pair of Holland Lop rabbits lounges near the hay bale, ears flopped.",
            },
          ],
        },
        "radio.description": {
          "span": {
            "column": 3,
            "endColumn": 26,
            "endLine": 435,
            "line": 433,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A battered portable radio held together with duct tape. The antenna is bent at a jaunty angle. A faded sticker on the side reads "ZOO FM — All Animals, All The Time."",
            },
          ],
        },
        "rope-perches.description": {
          "span": {
            "column": 3,
            "endColumn": 49,
            "endLine": 212,
            "line": 212,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Thick sisal ropes strung between wooden posts.",
            },
          ],
        },
        "snake.confession": {
          "span": {
            "column": 7,
            "endColumn": 14,
            "endLine": 258,
            "line": 254,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A soft, sibilant voice drifts from behind the glass of the snake enclosure. "Ssso... you're the one who stayed. Good. Do you know what it's like in here? They keep the lights on 'dim' and call it 'nocturnal.' I haven't seen actual moonlight in three years. Three. Years."",
            },
          ],
        },
        "snake.description": {
          "span": {
            "column": 3,
            "endColumn": 13,
            "endLine": 249,
            "line": 248,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A thick-bodied python coiled behind glass, nearly invisible in the dim red light.",
            },
          ],
        },
        "souvenir-penny.description": {
          "span": {
            "column": 3,
            "endColumn": 24,
            "endLine": 381,
            "line": 381,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A shiny copper penny.",
            },
          ],
        },
        "souvenir-press.description": {
          "span": {
            "column": 3,
            "endColumn": 52,
            "endLine": 419,
            "line": 417,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A heavy cast-iron machine with a big crank handle. A slot on top accepts pennies, and the mechanism stamps them with a zoo animal design. A sign reads: "INSERT PENNY, TURN HANDLE, KEEP FOREVER!"",
            },
          ],
        },
        "staff-gate-blocked": {
          "span": {
            "column": 3,
            "endColumn": 30,
            "endLine": 755,
            "line": 754,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The staff gate is closed.",
            },
          ],
        },
        "staff-gate.description": {
          "span": {
            "column": 3,
            "endColumn": 48,
            "endLine": 142,
            "line": 142,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A sturdy metal gate with a "STAFF ONLY" sign.",
            },
          ],
        },
        "staff-gate.gate-look": {
          "span": {
            "column": 7,
            "endColumn": 20,
            "endLine": 148,
            "line": 146,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [
                "gate-status",
              ],
              "text": "A sturdy metal gate with a "STAFF ONLY" sign.

{gate-status}",
            },
          ],
        },
        "staff-keycard.description": {
          "span": {
            "column": 3,
            "endColumn": 8,
            "endLine": 135,
            "line": 134,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A white plastic keycard with "WILLOWBROOK ZOO — STAFF ONLY" printed in blue.",
            },
          ],
        },
        "staff-parking-lot.description": {
          "span": {
            "column": 3,
            "endColumn": 74,
            "endLine": 120,
            "line": 120,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A small staff parking lot beyond the zoo fence. Off limits to visitors.",
            },
          ],
        },
        "stuffed-animals.description": {
          "span": {
            "column": 3,
            "endColumn": 49,
            "endLine": 266,
            "line": 266,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Shelves of plush tigers, pandas, and penguins.",
            },
          ],
        },
        "sugar-gliders.description": {
          "span": {
            "column": 3,
            "endColumn": 58,
            "endLine": 226,
            "line": 226,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A family of tiny sugar gliders with enormous dark eyes.",
            },
          ],
        },
        "supply-room.description": {
          "span": {
            "column": 3,
            "endColumn": 9,
            "endLine": 84,
            "line": 81,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A cluttered storage room behind the staff gate. Metal shelves line the walls. A cork board on the wall is covered with staff schedules. A battered radio sits on one of the shelves. The staff gate leads back north.",
            },
          ],
        },
        "ticket-booth.description": {
          "span": {
            "column": 3,
            "endColumn": 56,
            "endLine": 163,
            "line": 163,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A small wooden booth with a "Self-Guided Tours" sign.",
            },
          ],
        },
        "took-photo": {
          "span": {
            "column": 5,
            "endColumn": 14,
            "endLine": 538,
            "line": 536,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [
                "the target",
              ],
              "text": "Click! You snap a photo of {the target}. That one's going on the fridge.",
            },
          ],
        },
        "toucan.description": {
          "span": {
            "column": 3,
            "endColumn": 56,
            "endLine": 198,
            "line": 198,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A Toco toucan with an enormous orange-and-black bill.",
            },
          ],
        },
        "victory": {
          "span": {
            "column": 3,
            "endColumn": 25,
            "endLine": 762,
            "line": 756,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Congratulations! You've earned your MASTER ZOOKEEPER badge! You've visited every exhibit, befriended the animals, collected souvenirs, and even stayed after hours to hear what the animals really think. The Willowbrook Family Zoo will never forget you!

*** You have won ***",
            },
          ],
        },
        "warning-sign.description": {
          "span": {
            "column": 3,
            "endColumn": 61,
            "endLine": 328,
            "line": 328,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A yellow warning sign near the nocturnal exhibit entrance.",
            },
          ],
        },
        "warning-sign.sign-text": {
          "span": {
            "column": 7,
            "endColumn": 25,
            "endLine": 334,
            "line": 332,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "CAUTION: The Nocturnal Animals Exhibit is kept dark. Please use a flashlight. Do NOT use camera flash. (We don't talk about the Great Owl Incident of 2022.)",
            },
          ],
        },
        "waterfall.description": {
          "span": {
            "column": 3,
            "endColumn": 62,
            "endLine": 205,
            "line": 205,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A gentle artificial waterfall cascading into a stone basin.",
            },
          ],
        },
        "welcome-sign.description": {
          "span": {
            "column": 3,
            "endColumn": 77,
            "endLine": 156,
            "line": 156,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A brightly painted wooden sign reads: "WELCOME TO WILLOWBROOK FAMILY ZOO."",
            },
          ],
        },
        "zoo-brochure.description": {
          "span": {
            "column": 3,
            "endColumn": 73,
            "endLine": 343,
            "line": 343,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A glossy tri-fold brochure with "WILLOWBROOK FAMILY ZOO" on the cover.",
            },
          ],
        },
        "zoo-entrance.description": {
          "span": {
            "column": 3,
            "endColumn": 50,
            "endLine": 19,
            "line": 16,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "You stand before the wrought-iron gates of the Willowbrook Family Zoo. A cheerful welcome sign arches over the entrance, and a small ticket booth sits to one side. A sturdy iron fence runs along either side of the gates. The main path leads south into the zoo grounds.",
            },
          ],
        },
        "zoo-feeding-time-announced": {
          "span": {
            "column": 7,
            "endColumn": 54,
            "endLine": 700,
            "line": 699,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "*DING DONG* "It's FEEDING TIME at the Petting Zoo! Come watch our pygmy goats and rabbits enjoy their favorite snacks!"",
            },
          ],
        },
        "zoo-map.description": {
          "span": {
            "column": 3,
            "endColumn": 56,
            "endLine": 356,
            "line": 356,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A colorful folding map of the Willowbrook Family Zoo.",
            },
          ],
        },
        "zoo-pa-closed": {
          "span": {
            "column": 7,
            "endColumn": 48,
            "endLine": 691,
            "line": 690,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "*DING DONG* "The Willowbrook Family Zoo is now closed. Thank you for visiting! We hope to see you again soon!"",
            },
          ],
        },
        "zoo-pa-closing-1": {
          "span": {
            "column": 7,
            "endColumn": 40,
            "endLine": 687,
            "line": 686,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "*DING DONG* "Attention visitors! One hour until closing. Please begin making your way toward the exit."",
            },
          ],
        },
        "zoo-pa-closing-2": {
          "span": {
            "column": 7,
            "endColumn": 47,
            "endLine": 683,
            "line": 682,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "*DING DONG* "Attention visitors! Two hours until closing. Don't forget to stop by the gift shop for souvenirs!"",
            },
          ],
        },
        "zoo-pa-closing-3": {
          "span": {
            "column": 7,
            "endColumn": 21,
            "endLine": 679,
            "line": 677,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "*DING DONG* "Attention visitors! The Willowbrook Family Zoo will be closing in three hours. Please make sure to visit all exhibits before closing time!"",
            },
          ],
        },
        "zookeeper.departs": {
          "span": {
            "column": 7,
            "endColumn": 16,
            "endLine": 558,
            "line": 554,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "The zookeeper glances at the clock, unclips the walkie-talkie from his belt, and stretches. "Well, that's me done for the day. Zoo's all yours, I guess!" He gives you a friendly wave and ambles off toward the staff parking lot. A moment later, you hear an engine start and fade into the distance.",
            },
          ],
        },
        "zookeeper.description": {
          "span": {
            "column": 3,
            "endColumn": 66,
            "endLine": 546,
            "line": 546,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "A friendly zookeeper in khaki overalls. A name tag reads "Sam."",
            },
          ],
        },
        "zookeeper.presence": {
          "span": {
            "column": 3,
            "endColumn": 56,
            "endLine": 549,
            "line": 548,
          },
          "strategy": null,
          "variants": [
            {
              "markers": [],
              "text": "Sam the zookeeper is here, jingling a ring of keys.",
            },
          ],
        },
      },
    },
  },
