{
  "name": "@sharpee/ext-testing",
  "version": "5.4.0",
  "description": "Debug and testing tools extension for Sharpee IF engine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "clean": "rimraf dist dist-esm tsconfig.tsbuildinfo",
    "build:npm": "tsc --outDir dist"
  },
  "dependencies": {
    "@sharpee/core": "workspace:*",
    "@sharpee/world-model": "workspace:*",
    "@sharpee/if-domain": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "sharpee",
    "interactive-fiction",
    "testing",
    "debug"
  ],
  "license": "MIT",
  "module": "./dist-esm/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChicagoDave/sharpee.git",
    "directory": "packages/extensions/testing"
  }
}
