{
  "name": "@sharpee/branch-tester",
  "version": "5.0.0",
  "description": "Tree-native transcript testing for Sharpee: a transcript names its parent, every test is a branch, and a run covers every root-to-leaf path (ADR-302)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "clean": "rimraf dist dist-esm tsconfig.tsbuildinfo tsconfig.esm.tsbuildinfo",
    "build:npm": "tsc --outDir dist",
    "test": "vitest run",
    "test:ci": "vitest run"
  },
  "dependencies": {
    "@sharpee/bootstrap": "workspace:*",
    "@sharpee/core": "workspace:*",
    "@sharpee/engine": "workspace:*",
    "@sharpee/world-model": "workspace:*",
    "@sharpee/stdlib": "workspace:*",
    "@sharpee/lang-en-us": "workspace:*",
    "@sharpee/parser-en-us": "workspace:*",
    "@sharpee/channel-service": "workspace:*",
    "chalk": "^4.1.2",
    "glob": "^10.3.10"
  },
  "devDependencies": {
    "@sharpee/ide-protocol": "workspace:*",
    "@types/node": "^20.11.19",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.0"
  },
  "keywords": [
    "sharpee",
    "interactive-fiction",
    "testing",
    "branches"
  ],
  "author": "Sharpee Team",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist-esm/index.js",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist-esm/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/ChicagoDave/sharpee.git",
    "directory": "packages/branch-tester"
  }
}
