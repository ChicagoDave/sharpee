/**
 * Browser entry point for {{STORY_TITLE}} — generated by Sharpee IDE.
 *
 * A starting point that wires this story into the browser client. Add any
 * story-specific channel/audio renderers before `client.start()`.
 */

import { GameEngine, type Story } from '@sharpee/engine';
import { WorldModel, EntityType } from '@sharpee/world-model';
import { Parser } from '@sharpee/parser-en-us';
import { LanguageProvider } from '@sharpee/lang-en-us';
import { PerceptionService } from '@sharpee/stdlib';
import { BrowserClient, ThemeManager } from '@sharpee/platform-browser';
import { createStory } from './index.js';
import { STORY_VERSION, ENGINE_VERSION, BUILD_DATE } from './version.js';

const THEME_STORAGE_KEY = '{{STORY_ID}}-theme';
ThemeManager.applyEarlyTheme(THEME_STORAGE_KEY);

// Config-only instance (cheap); the playable story instance is created
// fresh inside start() per boot (ADR-248 factory contract).
const config = createStory().config;
const author = config.author;
const client = new BrowserClient({
  storagePrefix: '{{STORY_ID}}-',
  // ADR-248: RESTART reboots by re-running this entry's boot path.
  reboot: () => start(),
  defaultTheme: 'modern-dark',
  themes: [
    { id: 'modern-dark', name: 'Modern Dark' },
    { id: 'paper', name: 'Paper' },
  ],
  storyInfo: {
    title: config.title,
    description: config.description || '',
    authors: Array.isArray(author) ? author.join(', ') : author,
    version: STORY_VERSION,
    engineVersion: ENGINE_VERSION,
    buildDate: BUILD_DATE,
  },
});

async function start(): Promise<void> {
  client.initialize({
    statusLocation: document.getElementById('location-name'),
    statusScore: document.getElementById('score-turns'),
    textContent: document.getElementById('text-content'),
    mainWindow: document.getElementById('main-window'),
    commandInput: document.getElementById('command-input') as HTMLInputElement,
    saveDialog: document.getElementById('save-dialog') as HTMLDialogElement,
    restoreDialog: document.getElementById('restore-dialog') as HTMLDialogElement,
    startupDialog: document.getElementById('startup-dialog') as HTMLDialogElement,
    saveNameInput: document.getElementById('save-name-input') as HTMLInputElement,
    saveSlotsListEl: document.getElementById('save-slots-list'),
    restoreSlotsListEl: document.getElementById('restore-slots-list'),
    noSavesMessage: document.getElementById('no-saves-message'),
    startupSaveInfo: document.getElementById('startup-save-info'),
    menuBar: document.getElementById('menu-bar'),
  });

  // Fresh story instance per boot (ADR-248): a restart reboot re-runs
  // start() and must get fully fresh story state.
  const story = createStory();

  const world = new WorldModel();
  const player = world.createEntity('player', EntityType.ACTOR);
  world.setPlayer(player.id);

  const language = new LanguageProvider();
  const parser = new Parser(language);
  // `story` may be typed as a concrete class that omits the optional Story hooks
  // (extendParser/extendLanguage). View it through the Story interface so these
  // checks compile regardless of how the story file annotates its export.
  const typedStory: Story = story;
  if (typedStory.extendParser) typedStory.extendParser(parser);
  if (typedStory.extendLanguage) typedStory.extendLanguage(language);

  const perceptionService = new PerceptionService();
  // Pinned play seed (ADR-299 D5): the Sharpee IDE's play surface sets this
  // global before any client script runs, so every boot — including restart
  // reboots, which re-run start() — executes at the skein's one pinned seed.
  // A published page never defines it and boots at the clock as before.
  const playSeed = (globalThis as { __SHARPEE_PLAY_SEED__?: unknown }).__SHARPEE_PLAY_SEED__;
  // The seed rides EngineConfig (options.config.seed) — a top-level `seed`
  // on the options object is silently ignored by the GameEngine constructor.
  const engine = new GameEngine({
    world, player, parser, language, perceptionService,
    ...(typeof playSeed === 'number' ? { config: { seed: playSeed } } : {}),
  });
  // Outcome forcings for this boot (ADR-299 D5), set by the IDE when replaying
  // a forced branch of the skein so the live story reproduces the
  // counterfactual rather than what the pinned seed would have drawn. The host
  // passes ALREADY-STRUCTURED specs (`RandomForceSpec`), never the
  // `point[#occurrence]=CLASS` header text — parsing that grammar belongs to
  // transcript-tester, and a second copy shipped in every page would drift.
  // Forces are session state, never save state (ADR-293 D9), so they load per
  // boot. A published page never defines the global.
  const playForces = (globalThis as { __SHARPEE_PLAY_FORCES__?: unknown }).__SHARPEE_PLAY_FORCES__;
  if (Array.isArray(playForces) && playForces.length > 0) {
    try {
      const random = engine.getRandomService();
      random.clearForces();
      random.loadForces(playForces as Parameters<typeof random.loadForces>[0]);
    } catch (error) {
      // Surface it rather than blanking the page: an authoring surface running
      // unforced-but-visible beats a dead boot.
      console.error('[sharpee] could not apply the IDE play forcings:', error);
    }
  }

  client.connectEngine(engine, world);
  engine.setStory(story);
  engine.registerSaveRestoreHooks(client.getSaveRestoreHooks());

  await client.start();
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', start);
} else {
  start();
}
