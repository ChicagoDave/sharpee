// tsconfig.test.json — typechecks this package's test files (GH #401).
//
// The package's own tsconfig scopes `include` to src/**/* and excludes *.test.ts,
// and vitest transpiles through esbuild without typechecking, so before this file
// existed no command in the repository ever compiled a test file.
//
// Why the overrides: `rootDir` moves to the package root so tests/ is allowed
// beside src/; `composite`/`declaration` go off because this project only ever
// checks; `exclude` is replaced rather than extended, since the parent's
// exclusion of *.test.ts is the very thing being undone. `vitest/globals` supplies
// describe/it/expect, matching `globals: true` in the vitest configs.
//
// `_action-test-template.ts` is scaffolding an author copies, not a test: its
// `IFActions.YOUR_ACTION` placeholders are meant to be replaced, so it is excluded
// here rather than made to compile (ruled 2026-11-08).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "module": "esnext",
    "rootDir": ".",
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "__tests__/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-esm",
    "tests/unit/actions/_action-test-template.ts"
  ]
}
